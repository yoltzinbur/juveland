---
// Territorio Emprende — PLAN.md Pasada 1, paso 11 / DESIGN.md §6.
//
// El formulario real (Google Form de IMJUVE) queda PENDIENTE hasta que IMJUVE
// lo confirme. Mientras tanto el registro es por mensaje directo de WhatsApp
// al número de contacto; NO se piden datos personales aquí — si hacen falta,
// IMJUVE los recaba por su cuenta. Por eso tampoco va el aviso de privacidad
// todavía. En cuanto llegue el Google Form oficial, esta sección se reemplaza
// por el embed en tarjeta sticker + su línea de aviso de privacidad
// (ver DESIGN.md §6).
//
// `id="territorio-emprende"` — ancla del CTA del Hero, del botón del Navbar y
// del link del Footer; hasta que existió esta sección esos links quedaban
// colgando.

const phoneDisplay = '+52 1 55 2295 8774';
const whatsappUrl =
	'https://wa.me/5215522958774?text=' +
	encodeURIComponent('Hola, quiero registrarme en Territorio Emprende del 1er Festival de las Juventudes de Jilotepec.');
---

<section id="territorio-emprende" class="px-sm py-xl">
	<div class="mx-auto flex max-w-2xl flex-col items-center gap-md text-center lg:max-w-3xl">
		<div class="flex flex-col items-center gap-2">
			<h2 class="font-headline text-2xl font-bold text-ink uppercase sm:text-3xl lg:text-4xl">Territorio Emprende</h2>
			<p class="font-body text-ink/70 lg:text-lg">
				Muestra o vende tu proyecto frente a todo Jilotepec. Para registrarte, mándanos un mensaje de WhatsApp y te
				pasamos los detalles.
			</p>
		</div>

		<a
			href={whatsappUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="ink-outline sticker-shadow inline-flex items-center gap-2 rounded-chip bg-red px-lg py-3 font-headline text-sm font-bold text-cream uppercase transition-transform duration-150 ease-out hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none lg:px-10 lg:py-4 lg:text-base"
		>
			<svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
				<path
					d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.967-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.101 11.945c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652a11.882 11.882 0 0 0 5.71 1.447h.006c6.585 0 11.946-5.359 11.949-11.945a11.87 11.87 0 0 0-3.495-8.404"
				></path>
			</svg>
			Escríbenos por WhatsApp
		</a>

		<p class="font-body text-sm text-ink/70">
			o guarda el número: <span class="font-bold whitespace-nowrap text-ink">{phoneDisplay}</span>
		</p>
	</div>
</section>
