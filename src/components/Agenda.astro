---
// La hora del evento va fija en -06:00 (centro de México, sin horario de
// verano desde 2022) para no depender de la zona horaria del visitante.
import { lineup } from '../data/lineup';
---

{/* `overflow-x-clip`: el estado inicial de gsap.from (x: ±60) se pinta al
     cargar, antes de que dispare el ScrollTrigger, y causaría scroll
     horizontal en móvil. */}
<section id="agenda" class="overflow-x-clip px-sm py-xl">
	<div class="mx-auto flex max-w-2xl flex-col items-center gap-md lg:max-w-3xl">
		<div class="agenda-heading flex flex-col items-center gap-2 text-center">
			<h2 class="font-headline text-2xl font-bold text-ink uppercase sm:text-3xl lg:text-4xl">¡Ya casi!</h2>
			<p class="font-body text-ink/70 lg:text-lg">Sábado 29 de agosto · 2:00 PM · Alameda de Jilotepec</p>
		</div>

		<div class="countdown-card ink-outline sticker-shadow flex w-fit flex-col items-center gap-sm rounded-card bg-lime px-lg py-md lg:px-10 lg:py-lg">
			<span class="font-headline text-xs font-bold tracking-wide text-ink/70 uppercase lg:text-sm">Faltan</span>
			<div
				class="flex items-start gap-xs sm:gap-sm"
				id="countdown-numbers"
				data-target="2026-08-29T14:00:00-06:00"
				data-schedule={JSON.stringify(lineup.map((i) => ({ t: i.time, n: i.name })))}
			>
				<div class="flex flex-col items-center">
					<span
						class="inline-block min-w-[2ch] text-center font-display text-4xl font-bold text-ink tabular-nums sm:text-5xl lg:text-6xl"
						data-unit="days">00</span
					>
					<span class="font-headline text-[10px] font-bold text-ink/70 uppercase sm:text-xs lg:text-sm">días</span>
				</div>
				<span class="pt-1 font-display text-3xl font-bold text-ink/40 sm:text-4xl lg:text-5xl">:</span>
				<div class="flex flex-col items-center">
					<span
						class="inline-block min-w-[2ch] text-center font-display text-4xl font-bold text-ink tabular-nums sm:text-5xl lg:text-6xl"
						data-unit="hours">00</span
					>
					<span class="font-headline text-[10px] font-bold text-ink/70 uppercase sm:text-xs lg:text-sm">hrs</span>
				</div>
				<span class="pt-1 font-display text-3xl font-bold text-ink/40 sm:text-4xl lg:text-5xl">:</span>
				<div class="flex flex-col items-center">
					<span
						class="inline-block min-w-[2ch] text-center font-display text-4xl font-bold text-ink tabular-nums sm:text-5xl lg:text-6xl"
						data-unit="minutes">00</span
					>
					<span class="font-headline text-[10px] font-bold text-ink/70 uppercase sm:text-xs lg:text-sm">min</span>
				</div>
				<span class="pt-1 font-display text-3xl font-bold text-ink/40 sm:text-4xl lg:text-5xl">:</span>
				<div class="flex flex-col items-center">
					<span
						class="inline-block min-w-[2ch] text-center font-display text-4xl font-bold text-ink tabular-nums sm:text-5xl lg:text-6xl"
						data-unit="seconds">00</span
					>
					<span class="font-headline text-[10px] font-bold text-ink/70 uppercase sm:text-xs lg:text-sm">seg</span>
				</div>
			</div>
		</div>

		<h3 class="agenda-subheading mt-md font-headline text-xl font-bold text-ink uppercase sm:text-2xl lg:text-3xl">Agenda del día</h3>

		<div class="flex w-full flex-col gap-sm">
			{
				lineup.map((item) => (
					<div class={`agenda-item ink-outline sticker-shadow-sm relative flex overflow-hidden rounded-card ${item.bg}`}>
						<div class="relative flex w-20 shrink-0 items-center justify-center border-r-2 border-dashed border-ink py-sm sm:w-24 lg:w-28">
							<span class={`font-headline text-lg font-extrabold tabular-nums sm:text-xl lg:text-2xl ${item.text}`}>{item.time}</span>
							<span class="ink-outline absolute -top-2 -right-2 h-4 w-4 rounded-full bg-cream" />
							<span class="ink-outline absolute -right-2 -bottom-2 h-4 w-4 rounded-full bg-cream" />
						</div>
						<div class="flex flex-1 items-center px-md py-sm lg:px-lg">
							<span class={`font-headline text-sm font-bold uppercase sm:text-base lg:text-lg ${item.text}`}>{item.name}</span>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	// El countdown también arranca hasta que la sección se acerca al viewport:
	// está bajo el pliegue y no tiene caso tickear algo que nadie ve.
	import { whenSectionVisible, loadScrollGsap } from '../scripts/reveal';

	whenSectionVisible('#agenda').then(async (section) => {
		if (!section) return;
		const { gsap } = await loadScrollGsap();

		const heading = section.querySelector<HTMLElement>('.agenda-heading');
		const headingTitle = section.querySelector<HTMLElement>('.agenda-heading h2');
		const countdownCard = section.querySelector<HTMLElement>('.countdown-card');
		const subheading = section.querySelector<HTMLElement>('.agenda-subheading');
		const agendaItems = Array.from(section.querySelectorAll<HTMLElement>('.agenda-item'));

		gsap.matchMedia().add(
			{
				reduceMotion: '(prefers-reduced-motion: reduce)',
				motionOk: '(prefers-reduced-motion: no-preference)',
			},
			(context) => {
				const { reduceMotion } = context.conditions as { reduceMotion: boolean };

				const tl = gsap.timeline({
					scrollTrigger: {
						trigger: section,
						start: 'top 78%',
						toggleActions: 'play none none reverse',
					},
				});

				if (heading) {
					tl.from(heading, {
						opacity: 0,
						y: reduceMotion ? 0 : 16,
						duration: reduceMotion ? 0.3 : 0.5,
						ease: 'power2.out',
					});
				}

				if (countdownCard) {
					tl.from(
						countdownCard,
						{
							opacity: 0,
							y: reduceMotion ? 0 : 20,
							scale: reduceMotion ? 1 : 0.9,
							duration: reduceMotion ? 0.3 : 0.5,
							ease: 'back.out(1.6)',
						},
						reduceMotion ? undefined : '-=0.2',
					);
				}

				if (subheading) {
					tl.from(subheading, {
						opacity: 0,
						y: reduceMotion ? 0 : 16,
						duration: reduceMotion ? 0.3 : 0.5,
						ease: 'power2.out',
					});
				}

				if (agendaItems.length) {
					// Pares desde la izquierda, impares desde la derecha.
					tl.from(
						agendaItems,
						{
							opacity: 0,
							x: reduceMotion ? 0 : (i: number) => (i % 2 === 0 ? -60 : 60),
							y: 0,
							duration: reduceMotion ? 0.3 : 0.55,
							ease: 'power2.out',
							stagger: reduceMotion ? 0 : 0.08,
						},
						reduceMotion ? undefined : '-=0.2',
					);
				}
			},
		);

		// Fases: upcoming (cuenta regresiva) → live → ended.
		const wrapper = document.getElementById('countdown-numbers');
		const target = new Date(wrapper?.dataset.target ?? '');
		// El line-up termina a las 22:00; "En vivo" se mantiene hasta medianoche.
		const endOfEvent = target.getTime() + 10 * 60 * 60 * 1000;

		type Slot = { t: string; n: string };
		let schedule: Slot[] = [];
		try {
			schedule = JSON.parse(wrapper?.dataset.schedule ?? '[]');
		} catch {
			schedule = [];
		}

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const phaseOf = (now: number): 'upcoming' | 'live' | 'ended' =>
			now < target.getTime() ? 'upcoming' : now < endOfEvent ? 'live' : 'ended';

		// Último horario que ya pasó. Se calcula relativo a `target` (el primer
		// horario) para no depender de la zona horaria del visitante.
		const currentAct = (now: number): string => {
			const first = schedule[0];
			if (!first) return '';
			const toMs = (hhmm: string) => {
				const [h, m] = hhmm.split(':').map(Number);
				return (h * 60 + m) * 60 * 1000;
			};
			const anchor = target.getTime() - toMs(first.t);
			let act = first.n;
			for (const slot of schedule) {
				if (now >= anchor + toMs(slot.t)) act = slot.n;
			}
			return act;
		};

		let watchId: ReturnType<typeof setInterval> | undefined;
		let countdownId: ReturnType<typeof setInterval> | undefined;

		const renderEnded = () => {
			if (headingTitle) headingTitle.textContent = '¡Gracias por venir!';
			if (!countdownCard) return;
			countdownCard.innerHTML = `
				<span class="font-headline text-xs font-bold tracking-wide text-ink/70 uppercase lg:text-sm">29 de agosto de 2026</span>
				<span class="font-display text-3xl font-bold text-ink sm:text-4xl lg:text-5xl">¡Gracias por venir!</span>
				<span class="font-body text-sm text-ink/70 lg:text-base">Gracias a todas y todos por acompañarnos.</span>
			`;
		};

		const updateAct = () => {
			const el = countdownCard?.querySelector<HTMLElement>('[data-live-act]');
			if (!el) return;
			const act = currentAct(Date.now());
			el.textContent = act ? `En el escenario: ${act}` : 'El festival está pasando en la Alameda';
		};

		const renderLive = () => {
			if (headingTitle) headingTitle.textContent = '¡Es hoy!';
			if (!countdownCard) return;
			countdownCard.classList.remove('bg-lime');
			countdownCard.classList.add('bg-red');
			countdownCard.innerHTML = `
				<div class="flex items-center gap-xs">
					<span class="countdown-live-dot inline-block h-2.5 w-2.5 rounded-full bg-cream lg:h-3 lg:w-3"></span>
					<span class="font-headline text-sm font-extrabold tracking-widest text-cream uppercase lg:text-base">En vivo</span>
				</div>
				<span class="font-display text-3xl font-bold text-cream sm:text-4xl lg:text-5xl">¡Ya empezó!</span>
				<span class="font-body text-sm text-cream/85 lg:text-base" data-live-act></span>
			`;
			const dot = countdownCard.querySelector<HTMLElement>('.countdown-live-dot');
			if (dot && !reduceMotion) {
				gsap.to(dot, {
					opacity: 0.3,
					scale: 0.6,
					duration: 0.7,
					repeat: -1,
					yoyo: true,
					ease: 'sine.inOut',
				});
			}
			updateAct();
		};

		const watchForEnd = () => {
			watchId = setInterval(() => {
				if (phaseOf(Date.now()) === 'ended') {
					if (watchId) clearInterval(watchId);
					renderEnded();
					return;
				}
				updateAct();
			}, 60 * 1000);
		};

		const phase = phaseOf(Date.now());

		if (phase === 'ended') {
			renderEnded();
			return;
		}

		if (phase === 'live') {
			renderLive();
			watchForEnd();
			return;
		}

		const days = wrapper?.querySelector<HTMLElement>('[data-unit="days"]');
		const hours = wrapper?.querySelector<HTMLElement>('[data-unit="hours"]');
		const minutes = wrapper?.querySelector<HTMLElement>('[data-unit="minutes"]');
		const seconds = wrapper?.querySelector<HTMLElement>('[data-unit="seconds"]');

		const digitEls = [days, hours, minutes, seconds].filter((el): el is HTMLElement => Boolean(el));
		gsap.set(digitEls, { transformPerspective: 300 });

		// Sin flip en el primer render para no competir con la animación de entrada.
		let isFirstTick = true;

		// Flip con un solo elemento: gira hasta quedar de canto, cambia el texto
		// y termina de girar. Evita duplicar el DOM de cada dígito.
		const setDigit = (el: HTMLElement | null | undefined, value: string) => {
			if (!el || el.textContent === value) return;

			if (isFirstTick || reduceMotion) {
				el.textContent = value;
				return;
			}

			gsap.to(el, {
				rotationX: -90,
				duration: 0.15,
				ease: 'power1.in',
				onComplete: () => {
					el.textContent = value;
					gsap.fromTo(el, { rotationX: 90 }, { rotationX: 0, duration: 0.15, ease: 'power1.out' });
				},
			});
		};

		const pad = (n: number) => String(Math.max(n, 0)).padStart(2, '0');

		const tick = () => {
			const diff = target.getTime() - Date.now();

			if (diff <= 0) {
				stopCountdown();
				renderLive();
				watchForEnd();
				return;
			}

			const totalSeconds = Math.floor(diff / 1000);
			setDigit(days, pad(Math.floor(totalSeconds / 86400)));
			setDigit(hours, pad(Math.floor((totalSeconds % 86400) / 3600)));
			setDigit(minutes, pad(Math.floor((totalSeconds % 3600) / 60)));
			setDigit(seconds, pad(totalSeconds % 60));
			isFirstTick = false;
		};

		// Pausa el intervalo cuando la tarjeta sale de pantalla o la pestaña
		// queda en segundo plano.
		let inView = true;

		function stopCountdown() {
			if (countdownId !== undefined) {
				clearInterval(countdownId);
				countdownId = undefined;
			}
		}

		function startCountdown() {
			if (countdownId !== undefined) return;
			if (phaseOf(Date.now()) !== 'upcoming') return;
			tick();
			countdownId = setInterval(tick, 1000);
		}

		startCountdown();

		if ('IntersectionObserver' in window) {
			const vis = new IntersectionObserver((entries) => {
				inView = entries.some((entry) => entry.isIntersecting);
				if (inView && !document.hidden) startCountdown();
				else stopCountdown();
			});
			vis.observe(countdownCard ?? section);
		}

		document.addEventListener('visibilitychange', () => {
			if (document.hidden || !inView) stopCountdown();
			else startCountdown();
		});
	});
</script>
