---
// Cuenta regresiva + agenda rápida — PLAN.md Pasada 1, paso 7 / DESIGN.md §6.
// La agenda oficial ya llegó (line-up de IMJUVE, 9 bandas/horarios) — ya no
// hace falta el placeholder "Horario por confirmar" que preveía PLAN.md.
// Colores por tarjeta: se mapean 1:1 contra el gráfico oficial de line-up
// (rota red/blue/purple/green/lime, igual que dice PLAN.md), con el
// "amarillo" del gráfico resuelto a `lime` — es la 5ª tinta que el propio
// PLAN.md ya designó para esta rotación, no una tinta nueva inventada.
//
// Contraste de texto por tarjeta: no es la regla genérica de DESIGN.md §3
// ("texto sobre blue va en cream") porque, medido (WCAG), `ink` da mejor
// contraste sobre `blue` que `cream` — mismo criterio ya aplicado en
// Chips.astro.
//
// El countdown es en vivo (PLAN.md permite "estático... o con ella si es
// rápido") — un solo setInterval de 1s sin animación, así que no compite con
// el tick/flip de Pasada 2 (GSAP) que solo le agrega el efecto visual encima
// más adelante. Hora objetivo fija en -06:00 (Zona Centro de México, sin
// horario de verano desde 2022) para no depender de la zona horaria del
// visitante.
const items = [
	{ time: '14:00', name: 'Valentino', bg: 'bg-red', text: 'text-cream' },
	{ time: '15:00', name: 'The Rocktor Band', bg: 'bg-blue', text: 'text-ink' },
	{ time: '16:00', name: 'Marty BD', bg: 'bg-purple', text: 'text-cream' },
	{ time: '17:00', name: 'Los Corvett Latin Ska', bg: 'bg-green', text: 'text-ink' },
	{ time: '18:00', name: 'La Frecuenxia', bg: 'bg-lime', text: 'text-ink' },
	{ time: '19:00', name: 'Rapsodia', bg: 'bg-red', text: 'text-cream' },
	{ time: '20:00', name: 'Dopamina', bg: 'bg-blue', text: 'text-ink' },
	{ time: '21:00', name: 'Horus', bg: 'bg-purple', text: 'text-cream' },
	{ time: '22:00', name: 'The Sinners', bg: 'bg-lime', text: 'text-ink' },
];
---

<section id="agenda" class="px-sm py-xl">
	<div class="mx-auto flex max-w-2xl flex-col items-center gap-md lg:max-w-3xl">
		<div class="flex flex-col items-center gap-2 text-center">
			<h2 class="font-headline text-2xl font-bold text-ink uppercase sm:text-3xl lg:text-4xl">¡Ya casi!</h2>
			<p class="font-body text-ink/70 lg:text-lg">Sábado 29 de agosto · 2:00 PM · Alameda de Jilotepec</p>
		</div>

		<div class="ink-outline sticker-shadow flex w-fit flex-col items-center gap-sm rounded-card bg-lime px-lg py-md lg:px-10 lg:py-lg">
			<span class="font-headline text-xs font-bold tracking-wide text-ink/70 uppercase lg:text-sm">Faltan</span>
			<div class="flex items-start gap-xs sm:gap-sm" id="countdown-numbers" data-target="2026-08-29T14:00:00-06:00">
				<div class="flex flex-col items-center">
					<span class="font-display text-4xl font-bold text-ink tabular-nums sm:text-5xl lg:text-6xl" data-unit="days">00</span>
					<span class="font-headline text-[10px] font-bold text-ink/70 uppercase sm:text-xs lg:text-sm">días</span>
				</div>
				<span class="pt-1 font-display text-3xl font-bold text-ink/40 sm:text-4xl lg:text-5xl">:</span>
				<div class="flex flex-col items-center">
					<span class="font-display text-4xl font-bold text-ink tabular-nums sm:text-5xl lg:text-6xl" data-unit="hours">00</span>
					<span class="font-headline text-[10px] font-bold text-ink/70 uppercase sm:text-xs lg:text-sm">hrs</span>
				</div>
				<span class="pt-1 font-display text-3xl font-bold text-ink/40 sm:text-4xl lg:text-5xl">:</span>
				<div class="flex flex-col items-center">
					<span class="font-display text-4xl font-bold text-ink tabular-nums sm:text-5xl lg:text-6xl" data-unit="minutes">00</span>
					<span class="font-headline text-[10px] font-bold text-ink/70 uppercase sm:text-xs lg:text-sm">min</span>
				</div>
				<span class="pt-1 font-display text-3xl font-bold text-ink/40 sm:text-4xl lg:text-5xl">:</span>
				<div class="flex flex-col items-center">
					<span class="font-display text-4xl font-bold text-ink tabular-nums sm:text-5xl lg:text-6xl" data-unit="seconds">00</span>
					<span class="font-headline text-[10px] font-bold text-ink/70 uppercase sm:text-xs lg:text-sm">seg</span>
				</div>
			</div>
		</div>

		<h3 class="mt-md font-headline text-xl font-bold text-ink uppercase sm:text-2xl lg:text-3xl">Agenda del día</h3>

		<div class="flex w-full flex-col gap-sm">
			{
				items.map((item) => (
					<div class={`ink-outline sticker-shadow-sm relative flex overflow-hidden rounded-card ${item.bg}`}>
						<div class="relative flex w-20 shrink-0 items-center justify-center border-r-2 border-dashed border-ink py-sm sm:w-24 lg:w-28">
							<span class={`font-headline text-lg font-extrabold tabular-nums sm:text-xl lg:text-2xl ${item.text}`}>{item.time}</span>
							<span class="ink-outline absolute -top-2 -right-2 h-4 w-4 rounded-full bg-cream" />
							<span class="ink-outline absolute -right-2 -bottom-2 h-4 w-4 rounded-full bg-cream" />
						</div>
						<div class="flex flex-1 items-center px-md py-sm lg:px-lg">
							<span class={`font-headline text-sm font-bold uppercase sm:text-base lg:text-lg ${item.text}`}>{item.name}</span>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	const wrapper = document.getElementById('countdown-numbers');
	const target = new Date(wrapper?.dataset.target ?? '');

	const days = wrapper?.querySelector('[data-unit="days"]');
	const hours = wrapper?.querySelector('[data-unit="hours"]');
	const minutes = wrapper?.querySelector('[data-unit="minutes"]');
	const seconds = wrapper?.querySelector('[data-unit="seconds"]');

	const pad = (n) => String(Math.max(n, 0)).padStart(2, '0');

	const tick = () => {
		const diff = target.getTime() - Date.now();

		if (diff <= 0) {
			if (days) days.textContent = '00';
			if (hours) hours.textContent = '00';
			if (minutes) minutes.textContent = '00';
			if (seconds) seconds.textContent = '00';
			clearInterval(intervalId);
			return;
		}

		const totalSeconds = Math.floor(diff / 1000);
		if (days) days.textContent = pad(Math.floor(totalSeconds / 86400));
		if (hours) hours.textContent = pad(Math.floor((totalSeconds % 86400) / 3600));
		if (minutes) minutes.textContent = pad(Math.floor((totalSeconds % 3600) / 60));
		if (seconds) seconds.textContent = pad(totalSeconds % 60);
	};

	let intervalId;
	tick();
	intervalId = setInterval(tick, 1000);
</script>
