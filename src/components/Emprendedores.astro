---
// Emprendedores — muro de logos de los proyectos ya confirmados para Territorio
// Emprende. Va JUSTO ANTES de la sección de registro (Formulario.astro): sirve
// de prueba social ("estos ya son parte") que ancla el CTA de al lado
// ("¿Quieres formar parte?").
//
// Marco: banda `bg-green` de página completa — verde es el color-identidad de
// Territorio Emprende en DESIGN.md §3 ("tag de 'Territorio Emprende'"), así que
// vestir con él a los emprendedores + el CTA los liga visualmente. Estructura
// espejo de Trueque.astro: aquí el ArcDivider abre ARRIBA (rotate-180, entra
// con curva cóncava desde el cream del Mapa) y el corte de abajo es un borde
// `ink` recto (border-b-4) hacia Formulario. El `bg-green` va en un div
// interior, NO en el <section>, por lo mismo que Trueque: si vive en el
// <section> pinta también el área detrás del arco y el recorte cóncavo del SVG
// deja de verse (revelaría verde sobre verde).
//
// Texto en `ink` sobre `green`: mejor contraste WCAG que `cream` — mismo
// criterio ya documentado en src/data/lineup.ts y usado en Trueque.astro.
//
// Tarjetas: `bg-cream` + `ink-outline`/`sticker-shadow-sm` normales (no las
// variantes `*-invert`, que son solo para bandas `bg-ink`) — sobre verde el
// contorno y la sombra `ink` sí se ven. Uniformes, sin color rotando como las
// tarjetas de banda: cada logo trae su propia paleta (y varios, fondo o texto
// claro) y chocaría sobre una tinta saturada. Mismo criterio que los logos del
// footer. Cada tarjeta lleva el logo arriba (caja de alto fijo) y el nombre
// del emprendimiento debajo, en `font-headline` — varios logos son ilegibles
// en chico, así que el nombre en texto va aparte.
//
// El logo va con `object-contain` en una caja de alto fijo: normaliza
// proporciones muy distintas (wordmark horizontal vs. badge cuadrado) sin
// recortar. `rounded-lg` discreto en la <Image> — se nota en los logos que son
// un rectángulo opaco (fredhyloramas, jiloprint, las-botachelas…) y es inocuo
// en los de fondo transparente. <Image> infiere las dimensiones intrínsecas
// del ImageMetadata; `widths`+`sizes` porque el slot cambia de ancho al pasar
// el grid de 2 → 5 columnas.
//
// `quality={55}`: varios de los archivos fuente vienen como si fueran fotos
// (fredhyloramas ~163KB, ropa-aguilar ~104KB) y con la calidad por defecto
// Astro apenas los baja. Al tamaño al que se muestran, el recorte de calidad
// no se nota y evita servir 90-140KB por logo en la variante grande — la
// prioridad #1 del sitio es cargar rápido en celular (DESIGN.md).
//
// Animación de entrada (isla propia al final): mismo "abanico" de mazo de
// cartas que Bandas.astro — las tarjetas entran alternando rotación ±10° con
// `back.out`, como si se repartieran. GSAP + ScrollTrigger se importan en
// diferido (import() dinámico cuando la sección se acerca al viewport) y solo
// después de que se retira el Loader; respeta `prefers-reduced-motion` (cae a
// un fade+rise plano). El contenido es legible aunque el JS falle o tarde.
import { Image } from 'astro:assets';
import ArcDivider from './ArcDivider.astro';
import { emprendedores } from '../data/emprendedores';
---

<!-- `overflow-x-clip`: la animación de entrada rota las tarjetas ±10° (gsap.from,
     que se pinta en immediateRender apenas carga la página, antes de que el
     ScrollTrigger dispare), así que las esquinas giradas asoman por el borde
     derecho y aparece scroll horizontal en móvil hasta que la animación
     termina. `clip` lo contiene sin crear un contenedor de scroll ni afectar
     el eje vertical (a diferencia de `overflow-hidden`, que recortaría el
     arco). Mismo criterio que Bandas/Agenda. -->
<section id="emprendedores" class="relative overflow-x-clip">
	<ArcDivider fillClass="fill-green" class="-mb-0.5 h-10 rotate-180 sm:h-16" />

	<div class="border-b-4 border-ink bg-green px-sm pt-lg pb-xl">
		<div class="mx-auto flex max-w-2xl flex-col items-center gap-md text-center lg:max-w-4xl">
			<div class="emprendedores-heading flex flex-col items-center gap-2">
				<h2 class="font-headline text-2xl font-bold text-ink uppercase sm:text-3xl lg:text-4xl">Emprendedores</h2>
				<p class="font-body text-ink/80 lg:text-lg">Los proyectos que estarán en Territorio Emprende.</p>
			</div>

			{/* 10 logos → 2 columnas en móvil (5 filas exactas) y 5 en desktop
			    (2 filas exactas): ambos parten 10 sin dejar una tarjeta suelta,
			    así que no hace falta el truco de última tarjeta de Bandas.astro
			    (ese es para sus 9, impar). El salto 2→5 ocurre en `md` (768px),
			    donde 5 logos por fila aún tienen ~135px de slot. */}
			<div class="grid w-full grid-cols-2 gap-sm sm:gap-md md:grid-cols-5">
				{
					emprendedores.map((item) => (
						<div class="emprendedor-card ink-outline sticker-shadow-sm flex flex-col items-center gap-xs rounded-card bg-cream p-sm lg:p-md">
							<div class="flex h-28 w-full items-center justify-center lg:h-32">
								<Image
									src={item.logo}
									alt={item.name}
									widths={[160, 240, 320]}
									sizes="(min-width: 768px) 170px, 44vw"
									quality={55}
									class="max-h-full w-auto rounded-lg object-contain"
								/>
							</div>
							<span class="font-headline text-xs font-bold text-ink uppercase leading-tight lg:text-sm">
								{item.name}
							</span>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	// Pasada 2 (PLAN.md) — mismo "abanico" (rotación alternada + acomodo con
	// `back.out`) que Bandas.astro, para que las dos secciones de tarjetas
	// tengan el mismo lenguaje de entrada. Aislado en su propia isla de Astro.
	//
	// Afinación de rendimiento (mismo criterio que Bandas/Chips/Agenda): GSAP +
	// ScrollTrigger NO se importan estático — esta sección está bajo el pliegue,
	// así que entran con import() dinámico recién cuando se acerca al viewport
	// (IntersectionObserver, rootMargin 200px). El chunk de GSAP ya lo trae
	// Hero/Navbar de forma estática, así que el import() resuelve desde caché;
	// lo que se difiere es el trabajo (registerPlugin, timeline + ScrollTrigger,
	// el immediateRender de los .from() que empujan las tarjetas rotadas fuera
	// del viewport — ver overflow-x-clip en el <section>), no la descarga.
	const section = document.querySelector<HTMLElement>('#emprendedores');

	if (section) {
		const animate = async () => {
			const [{ gsap }, { ScrollTrigger }] = await Promise.all([
				import('gsap'),
				import('gsap/ScrollTrigger'),
			]);
			gsap.registerPlugin(ScrollTrigger);

			const heading = section.querySelector<HTMLElement>('.emprendedores-heading');
			const cards = Array.from(section.querySelectorAll<HTMLElement>('.emprendedor-card'));

			// Dos condiciones mutuamente excluyentes que cubren el 100% de los casos.
			gsap.matchMedia().add(
				{
					reduceMotion: '(prefers-reduced-motion: reduce)',
					motionOk: '(prefers-reduced-motion: no-preference)',
				},
				(context) => {
					const { reduceMotion } = context.conditions as { reduceMotion: boolean };

					const tl = gsap.timeline({
						scrollTrigger: {
							trigger: section,
							start: 'top 78%',
							toggleActions: 'play none none reverse',
						},
					});

					if (heading) {
						tl.from(heading, {
							opacity: 0,
							y: reduceMotion ? 0 : 16,
							duration: reduceMotion ? 0.3 : 0.5,
							ease: 'power2.out',
						});
					}

					if (cards.length) {
						// Alterna la rotación de entrada (izquierda/derecha) tarjeta por
						// tarjeta, como si se repartieran de un mazo — `back.out` para que
						// se sientan "acomodándose" al llegar, no solo deteniéndose.
						tl.from(
							cards,
							{
								opacity: 0,
								y: reduceMotion ? 0 : 30,
								scale: reduceMotion ? 1 : 0.8,
								rotation: reduceMotion ? 0 : (i: number) => (i % 2 === 0 ? -10 : 10),
								duration: reduceMotion ? 0.3 : 0.6,
								ease: 'back.out(1.6)',
								stagger: reduceMotion ? 0 : 0.06,
							},
							reduceMotion ? undefined : '-=0.25',
						);
					}
				},
			);
		};

		// No se empieza a observar hasta que el Loader se retira: si la sección
		// ya está por encima de la línea de disparo del ScrollTrigger en el load,
		// la entrada se reproduciría entera detrás del overlay del Loader.
		// `whenLoaderGone` resuelve al instante si no hay Loader o si ya se
		// ocultó; si no, espera el evento `juveland:loader-hidden` (con
		// salvavidas por si el Loader falla).
		const whenLoaderGone = () => {
			const loader = document.getElementById('loader');
			if (!loader || loader.dataset.hidden === 'true') return Promise.resolve();
			return new Promise<void>((resolve) => {
				window.addEventListener('juveland:loader-hidden', () => resolve(), { once: true });
				window.setTimeout(resolve, 4500);
			});
		};

		whenLoaderGone().then(() => {
			if ('IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries, obs) => {
						if (!entries.some((entry) => entry.isIntersecting)) return;
						obs.disconnect();
						animate();
					},
					{ rootMargin: '200px' },
				);
				io.observe(section);
			} else {
				animate();
			}
		});
	}
</script>
