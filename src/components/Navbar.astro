---
// Navbar — DESIGN.md §6. Píldora cream sticky, links a las secciones (se agregan
// sus `id` conforme se construyen en las siguientes sesiones de PLAN.md).
// Encogerse + más sombra al hacer scroll es Pasada 2 (GSAP) — aquí queda estático.
//
// `loading="eager"` en la mascota: el navbar es sticky y visible desde el
// primer frame, así que el `loading="lazy"` por defecto de <Image> no aplica
// (le baja prioridad a algo ya en pantalla) — mismo criterio que Loader.astro
// y Hero.astro.
import { Image } from 'astro:assets';
import mascotaMostaza from '../assets/hero/mascota-mostaza.png';

const links = [
	{ href: '#inicio', label: 'Inicio' },
	{ href: '#agenda', label: 'Agenda' },
	{ href: '#territorio-emprende', label: 'Territorio Emprende' },
	{ href: '#mapa', label: 'Mapa' },
	{ href: '#contacto', label: 'Contacto' },
];
---

<header class="sticky top-4 z-50 mx-auto w-[calc(100%-2rem)] max-w-5xl lg:max-w-6xl">
	<nav
		aria-label="Principal"
		class="ink-outline-thick sticker-shadow-sm flex items-center justify-between gap-sm rounded-chip bg-cream px-md py-xs lg:px-lg lg:py-sm"
	>
		<a
			href="#inicio"
			class="flex shrink-0 items-center gap-2 font-display text-lg font-semibold text-ink lg:text-xl"
			aria-label="Juveland, ir al inicio"
		>
			<Image
				src={mascotaMostaza}
				alt=""
				width={64}
				loading="eager"
				class="h-8 w-8 shrink-0 -scale-x-100 lg:h-9 lg:w-9"
			/>
			Juveland
		</a>

		<ul class="hidden items-center gap-lg font-headline text-sm font-semibold tracking-wide text-ink uppercase md:flex lg:text-base">
			{
				links.map((link) => (
					<li class="text-center">
						<a href={link.href} class="transition-colors hover:text-red">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<button
			type="button"
			id="nav-toggle"
			class="ink-outline sticker-shadow-sm flex shrink-0 items-center justify-center rounded-button bg-lime p-2 text-ink transition-transform duration-150 ease-out active:translate-y-0.5 active:shadow-none md:hidden"
			aria-expanded="false"
			aria-controls="nav-sheet"
			aria-label="Abrir menú"
		>
			<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
				<path d="M3 6h16M3 11h16M3 16h16" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" />
			</svg>
		</button>
	</nav>
</header>

<div id="nav-backdrop" class="fixed inset-0 z-40 hidden bg-ink/40 md:hidden"></div>

<div
	id="nav-sheet"
	role="dialog"
	aria-modal="true"
	aria-label="Menú"
	class="ink-outline-thick sticker-shadow fixed inset-x-3 bottom-3 z-50 hidden rounded-card bg-cream p-md md:hidden"
>
	{/* Sin CTA "Regístrate" aquí: mientras no exista el form de IMJUVE el registro
	   es por WhatsApp desde la sección Territorio Emprende, ya enlazada en la
	   lista de arriba — un botón aparte solo duplicaría ese link. */}
	<ul class="flex flex-col gap-xs font-headline text-lg font-semibold text-ink uppercase">
		{
			links.map((link) => (
				<li>
					<a href={link.href} class="nav-sheet-link block rounded-button px-sm py-2 hover:bg-lime">
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</div>

<script>
	const toggle = document.getElementById('nav-toggle');
	const sheet = document.getElementById('nav-sheet');
	const backdrop = document.getElementById('nav-backdrop');
	const sheetLinks = document.querySelectorAll('.nav-sheet-link');

	// El botón "atrás" del teléfono cierra el menú en vez de salir de la página
	// (SPA de una sola URL): al abrir se mete una entrada de historial y se
	// escucha `popstate`; al cerrar por acción del usuario se deshace con
	// `history.back()`.
	function onPopState() {
		closeSheet({ fromPopState: true });
	}

	const openSheet = () => {
		sheet?.classList.remove('hidden');
		backdrop?.classList.remove('hidden');
		toggle?.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
		history.pushState({ sheet: 'nav' }, '');
		window.addEventListener('popstate', onPopState);
	};

	const closeSheet = ({ fromPopState = false } = {}) => {
		if (sheet?.classList.contains('hidden')) return;
		sheet?.classList.add('hidden');
		backdrop?.classList.add('hidden');
		toggle?.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
		window.removeEventListener('popstate', onPopState);
		if (!fromPopState && history.state?.sheet === 'nav') history.back();
	};

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		if (isOpen) {
			closeSheet();
		} else {
			openSheet();
		}
	});

	backdrop?.addEventListener('click', () => closeSheet());

	// Los links del menú saltan a una sección (#ancla). Se cierra el menú
	// deshaciendo su entrada de historial (history.back vía closeSheet) y,
	// cuando ese popstate ya pasó, se navega al ancla — así el historial
	// queda [página] → [#sección] y un solo "atrás" regresa limpio, sin la
	// entrada del menú de por medio.
	sheetLinks.forEach((link) =>
		link.addEventListener('click', (event) => {
			const href = link.getAttribute('href');
			const isOpen = toggle?.getAttribute('aria-expanded') === 'true';
			if (isOpen && href && href.startsWith('#') && history.state?.sheet === 'nav') {
				event.preventDefault();
				window.addEventListener('popstate', () => { location.hash = href; }, { once: true });
				closeSheet();
			} else {
				closeSheet();
			}
		}),
	);

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeSheet();
	});
</script>

<script>
	// Pasada 2 (PLAN.md) — "encoger + sombra sticker al hacer scroll". En reposo
	// arriba del todo la píldora ya trae `sticker-shadow-sm` por CSS (así nunca
	// se ve "plana" ni depende de que el JS cargue); al bajar aunque sea un
	// poco, se encoge levemente y la sombra crece al offset completo de
	// `sticker-shadow` (4px), como si el contenido pasara debajo de ella y la
	// "levantara". Vuelve a su estado original al regresar a top. Aislado en su
	// propio <script> (Astro island, no bundle global) separado del script de
	// interacción del menú de arriba.
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const nav = document.querySelector<HTMLElement>('header nav');

	if (nav) {
		// El color de la sombra sale del mismo token que ya usa la utilidad
		// `sticker-shadow` (global.css) en vez de duplicar el hex a mano aquí.
		const inkColor = getComputedStyle(document.documentElement).getPropertyValue('--color-ink').trim();

		gsap.set(nav, { transformOrigin: 'center top' });

		// `duration: reduceMotion ? 0 : 0.3` en vez de no animar del todo: con
		// prefers-reduced-motion la píldora igual se encoge y gana la sombra al
		// hacer scroll (sigue siendo información útil), solo que sin easing de
		// por medio — ver gsap-core §Accessibility.
		//
		// Las dos condiciones son mutuamente excluyentes y cubren el 100% de los
		// casos (siempre hay match en una de las dos) — con una sola condición
		// (`reduceMotion` sola) el callback de matchMedia solo corre cuando ESA
		// media query da true, así que para el caso normal (sin reduced-motion)
		// nunca se ejecutaba y el ScrollTrigger no se llegaba a crear.
		gsap.matchMedia().add(
			{
				reduceMotion: '(prefers-reduced-motion: reduce)',
				motionOk: '(prefers-reduced-motion: no-preference)',
			},
			(context) => {
				const { reduceMotion } = context.conditions as { reduceMotion: boolean };

				gsap.timeline({
					scrollTrigger: {
						// Número simple = px totales scrolleados desde arriba (más
						// robusto que un string "top -8px": sin trigger de por medio
						// que ambigüe el parseo de la posición negativa).
						start: 8,
						toggleActions: 'play none none reverse',
					},
				}).to(nav, {
					scale: 0.94,
					boxShadow: `4px 4px 0 0 ${inkColor}`,
					duration: reduceMotion ? 0 : 0.3,
					ease: 'power2.out',
				});
			},
		);
	}
</script>
