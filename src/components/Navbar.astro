---
// Navbar — DESIGN.md §6. Píldora cream sticky, links a las secciones (se agregan
// sus `id` conforme se construyen en las siguientes sesiones de PLAN.md).
// Encogerse + más sombra al hacer scroll es Pasada 2 (GSAP) — aquí queda estático.
const links = [
	{ href: '#inicio', label: 'Inicio' },
	{ href: '#agenda', label: 'Agenda' },
	{ href: '#territorio-emprende', label: 'Territorio Emprende' },
	{ href: '#mapa', label: 'Mapa' },
	{ href: '#contacto', label: 'Contacto' },
];
---

<header class="sticky top-4 z-50 mx-auto w-[calc(100%-2rem)] max-w-5xl">
	<nav
		aria-label="Principal"
		class="ink-outline-thick sticker-shadow flex items-center justify-between gap-sm rounded-chip bg-cream px-md py-xs"
	>
		<a
			href="#inicio"
			class="flex shrink-0 items-center gap-2 font-display text-lg font-semibold text-ink"
			aria-label="Juveland, ir al inicio"
		>
			<!-- [pendiente IMJUVE: mascota real, ver DESIGN.md §9] mascota placeholder -->
			<svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
				<circle cx="16" cy="16" r="14" fill="var(--color-orange)" stroke="var(--color-ink)" stroke-width="2" />
				<circle cx="11" cy="14" r="2" fill="var(--color-ink)" />
				<circle cx="21" cy="14" r="2" fill="var(--color-ink)" />
				<path d="M11 20c1.8 1.6 8.2 1.6 10 0" fill="none" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" />
			</svg>
			Juveland
		</a>

		<ul class="hidden items-center gap-lg font-headline text-sm font-semibold tracking-wide text-ink uppercase md:flex">
			{
				links.map((link) => (
					<li>
						<a href={link.href} class="transition-colors hover:text-red">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<a
			href="#territorio-emprende"
			class="ink-outline sticker-shadow-sm hidden shrink-0 rounded-chip bg-red px-md py-2 font-headline text-sm font-bold text-cream uppercase transition-transform duration-150 ease-out hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none md:inline-block"
		>
			Regístrate
		</a>

		<button
			type="button"
			id="nav-toggle"
			class="ink-outline sticker-shadow-sm flex shrink-0 items-center justify-center rounded-button bg-lime p-2 text-ink transition-transform duration-150 ease-out active:translate-y-0.5 active:shadow-none md:hidden"
			aria-expanded="false"
			aria-controls="nav-sheet"
			aria-label="Abrir menú"
		>
			<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
				<path d="M3 6h16M3 11h16M3 16h16" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" />
			</svg>
		</button>
	</nav>
</header>

<div id="nav-backdrop" class="fixed inset-0 z-40 hidden bg-ink/40 md:hidden"></div>

<div
	id="nav-sheet"
	role="dialog"
	aria-modal="true"
	aria-label="Menú"
	class="ink-outline-thick sticker-shadow fixed inset-x-3 bottom-3 z-50 hidden rounded-card bg-cream p-md md:hidden"
>
	<ul class="flex flex-col gap-xs font-headline text-lg font-semibold text-ink uppercase">
		{
			links.map((link) => (
				<li>
					<a href={link.href} class="nav-sheet-link block rounded-button px-sm py-2 hover:bg-lime">
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
	<a
		href="#territorio-emprende"
		class="nav-sheet-link ink-outline sticker-shadow-sm mt-md block rounded-chip bg-red px-md py-3 text-center font-headline text-sm font-bold text-cream uppercase"
	>
		Regístrate
	</a>
</div>

<script>
	const toggle = document.getElementById('nav-toggle');
	const sheet = document.getElementById('nav-sheet');
	const backdrop = document.getElementById('nav-backdrop');
	const sheetLinks = document.querySelectorAll('.nav-sheet-link');

	const openSheet = () => {
		sheet?.classList.remove('hidden');
		backdrop?.classList.remove('hidden');
		toggle?.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	};

	const closeSheet = () => {
		sheet?.classList.add('hidden');
		backdrop?.classList.add('hidden');
		toggle?.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	};

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		if (isOpen) {
			closeSheet();
		} else {
			openSheet();
		}
	});

	backdrop?.addEventListener('click', closeSheet);
	sheetLinks.forEach((link) => link.addEventListener('click', closeSheet));

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeSheet();
	});
</script>
