---
// El encogimiento al hacer scroll es CSS (`animation-timeline: scroll()`),
// no GSAP: no vale la pena cargar ~110 KB de JS para eso. Sin soporte, la
// barra se queda en su estado de reposo.
import { Image } from 'astro:assets';
import mascotaMostaza from '../assets/hero/mascota-mostaza.png';
import { navLinks } from '../data/nav';
---

<header class="sticky top-4 z-50 mx-auto w-[calc(100%-2rem)] max-w-5xl lg:max-w-6xl">
	<nav
		aria-label="Principal"
		class="ink-outline-thick sticker-shadow-sm flex items-center justify-between gap-sm rounded-chip bg-cream px-md py-xs lg:px-lg lg:py-sm"
	>
		<a
			href="#inicio"
			class="flex shrink-0 items-center gap-2 font-display text-lg font-semibold text-ink lg:text-xl"
			aria-label="Juveland, ir al inicio"
		>
			<Image
				src={mascotaMostaza}
				alt=""
				width={64}
				loading="eager"
				class="h-8 w-8 shrink-0 -scale-x-100 lg:h-9 lg:w-9"
			/>
			Juveland
		</a>

		<ul class="hidden items-center gap-lg font-headline text-sm font-semibold tracking-wide text-ink uppercase md:flex lg:text-base">
			{
				navLinks.map((link) => (
					<li class="text-center">
						<a href={link.href} class="transition-colors hover:text-red">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<button
			type="button"
			id="nav-toggle"
			class="ink-outline sticker-shadow-sm flex shrink-0 items-center justify-center rounded-button bg-lime p-2 text-ink transition-transform duration-150 ease-out active:translate-y-0.5 active:shadow-none md:hidden"
			aria-expanded="false"
			aria-controls="nav-sheet"
			aria-label="Abrir menú"
		>
			<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
				<path d="M3 6h16M3 11h16M3 16h16" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" />
			</svg>
		</button>
	</nav>
</header>

<div id="nav-backdrop" class="fixed inset-0 z-40 hidden bg-ink/40 md:hidden"></div>

<div
	id="nav-sheet"
	role="dialog"
	aria-modal="true"
	aria-label="Menú"
	tabindex="-1"
	class="ink-outline-thick sticker-shadow fixed inset-x-3 bottom-3 z-50 hidden rounded-card bg-cream p-md md:hidden"
>
	<ul class="flex flex-col gap-xs font-headline text-lg font-semibold text-ink uppercase">
		{
			navLinks.map((link) => (
				<li>
					<a href={link.href} class="nav-sheet-link block rounded-button px-sm py-2 hover:bg-lime">
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</div>

<script>
	import { createFocusTrap } from '../scripts/focusTrap';

	const toggle = document.getElementById('nav-toggle');
	const sheet = document.getElementById('nav-sheet');
	const backdrop = document.getElementById('nav-backdrop');
	const sheetLinks = document.querySelectorAll('.nav-sheet-link');

	const trap = sheet ? createFocusTrap(sheet) : null;

	// El botón "atrás" del teléfono cierra el menú en vez de salir del sitio
	// (ver InfoSheet.astro).
	function onPopState() {
		closeSheet({ fromPopState: true });
	}

	const openSheet = () => {
		sheet?.classList.remove('hidden');
		backdrop?.classList.remove('hidden');
		toggle?.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
		history.pushState({ sheet: 'nav' }, '');
		window.addEventListener('popstate', onPopState);
		trap?.activate();
	};

	const closeSheet = ({ fromPopState = false, keepHistory = false } = {}) => {
		if (sheet?.classList.contains('hidden')) return;
		trap?.deactivate();
		sheet?.classList.add('hidden');
		backdrop?.classList.add('hidden');
		toggle?.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
		window.removeEventListener('popstate', onPopState);
		if (!fromPopState && !keepHistory && history.state?.sheet === 'nav') history.back();
	};

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		if (isOpen) {
			closeSheet();
		} else {
			openSheet();
		}
	});

	backdrop?.addEventListener('click', () => closeSheet());

	// Al elegir un link no se cierra con history.back(): el navegador
	// restauraría el scroll anterior después del popstate y anularía el salto
	// al ancla. Se reemplaza la entrada del menú por la de la sección y el
	// scroll se hace a mano.
	sheetLinks.forEach((link) =>
		link.addEventListener('click', (event) => {
			const href = link.getAttribute('href');
			if (!href || !href.startsWith('#')) {
				closeSheet();
				return;
			}
			event.preventDefault();
			if (history.state?.sheet === 'nav') {
				history.replaceState(null, '', href);
			} else {
				history.pushState(null, '', href);
			}
			closeSheet({ keepHistory: true });
			document.getElementById(href.slice(1))?.scrollIntoView({ block: 'start' });
		}),
	);

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeSheet();
	});
</script>

<style>
	/* En los primeros 64px de scroll la barra se encoge y la sombra crece.
	 * Se mantiene con reduced-motion porque la controla el usuario con el
	 * scroll, no es una animación autónoma. */
	@keyframes nav-shrink {
		to {
			transform: scale(0.94);
			box-shadow: 4px 4px 0 0 var(--color-ink);
		}
	}

	@supports (animation-timeline: scroll()) {
		header nav {
			transform-origin: center top;
			animation: nav-shrink linear both;
			animation-timeline: scroll(root block);
			animation-range: 0 64px;
		}
	}
</style>
