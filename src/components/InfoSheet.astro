---
// Botón + bottom sheet en móvil / modal centrado en desktop. Los ids internos
// se derivan de `id`, así que debe ser único por instancia.
//
// Ojo: el proyecto define `--spacing-xs…xl`, y Tailwind v4 resuelve
// `max-w-lg` contra esa escala (48px), no contra la de anchos (32rem). Por
// eso aquí va `max-w-[32rem]`.
interface Props {
	id: string;
	title: string;
	triggerLabel: string;
	triggerClass?: string;
}

const { id, title, triggerLabel, triggerClass = '' } = Astro.props;
---

<button
	type="button"
	id={`${id}-trigger`}
	data-info-sheet={id}
	aria-haspopup="dialog"
	aria-controls={`${id}-sheet`}
	aria-expanded="false"
	class={triggerClass}
>
	{triggerLabel}
</button>

<div id={`${id}-backdrop`} class="fixed inset-0 z-40 hidden bg-ink/40"></div>

<div
	id={`${id}-sheet`}
	role="dialog"
	aria-modal="true"
	aria-label={title}
	tabindex="-1"
	class="ink-outline-thick sticker-shadow fixed inset-x-3 bottom-3 z-50 hidden max-h-[75vh] overflow-y-auto rounded-card bg-cream p-md sm:inset-x-auto sm:top-1/2 sm:left-1/2 sm:bottom-auto sm:w-11/12 sm:max-w-[32rem] sm:-translate-x-1/2 sm:-translate-y-1/2"
>
	<div class="mb-sm flex items-center justify-between gap-sm">
		<h3 class="font-headline text-lg font-bold text-ink uppercase sm:text-xl lg:text-2xl">{title}</h3>
		<button
			type="button"
			id={`${id}-close`}
			aria-label="Cerrar"
			class="ink-outline sticker-shadow-sm flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-full bg-cream transition-transform duration-150 ease-out active:translate-y-0.5 active:shadow-none"
		>
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
				<path d="M1 1l12 12M13 1L1 13" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" />
			</svg>
		</button>
	</div>

	<div class="flex flex-col gap-sm font-body text-ink/90">
		<slot />
	</div>
</div>

<script>
	import { createFocusTrap } from '../scripts/focusTrap';

	document.querySelectorAll<HTMLButtonElement>('[data-info-sheet]').forEach((trigger) => {
		const id = trigger.dataset.infoSheet;
		if (!id) return;

		const sheet = document.getElementById(`${id}-sheet`);
		const backdrop = document.getElementById(`${id}-backdrop`);
		const closeBtn = document.getElementById(`${id}-close`);
		const trap = sheet ? createFocusTrap(sheet) : null;

		// El botón "atrás" del teléfono cierra el diálogo en vez de salir del
		// sitio: al abrir se agrega una entrada al historial, y al cerrar
		// manualmente se quita con `history.back()`.
		const onPopState = () => closeSheet({ fromPopState: true });

		const openSheet = () => {
			sheet?.classList.remove('hidden');
			backdrop?.classList.remove('hidden');
			trigger.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
			history.pushState({ sheet: id }, '');
			window.addEventListener('popstate', onPopState);
			trap?.activate();
		};

		const closeSheet = ({ fromPopState = false } = {}) => {
			if (sheet?.classList.contains('hidden')) return;
			trap?.deactivate();
			sheet?.classList.add('hidden');
			backdrop?.classList.add('hidden');
			trigger.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
			window.removeEventListener('popstate', onPopState);
			if (!fromPopState && history.state?.sheet === id) history.back();
		};

		trigger.addEventListener('click', openSheet);
		closeBtn?.addEventListener('click', () => closeSheet());
		backdrop?.addEventListener('click', () => closeSheet());

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeSheet();
		});
	});
</script>
