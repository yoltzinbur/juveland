---
// Hero — PLAN.md Pasada 1, paso 2 / DESIGN.md §6.
// Wordmark en HTML (contorno vía -webkit-text-stroke), mascotas y nubes
// estáticas (sin loop de flotación / parallax todavía — eso es Pasada 2,
// DESIGN.md §7), insignia + stat en las esquinas en desktop y como chips en
// línea en móvil para no saturar una pantalla chica con overlays absolutos.
import { Image } from 'astro:assets';
import Cloud from './Cloud.astro';
import mascotaVerde from '../assets/mascota-verde.png';
import mascotaMostaza from '../assets/mascota-mostaza.png';
---

<section id="inicio" class="relative overflow-hidden px-sm pt-lg pb-xl sm:pt-xl">
	<Cloud class="pointer-events-none absolute top-6 left-2 w-16 opacity-90 sm:top-8 sm:left-6 sm:w-24 md:w-28 lg:w-32" />
	<Cloud class="pointer-events-none absolute top-14 right-4 hidden w-14 opacity-80 sm:block md:right-12 md:w-20 lg:w-24" />

	<Image
		src={mascotaVerde}
		alt=""
		width={240}
		class="pointer-events-none absolute bottom-4 left-2 h-auto w-14 sm:bottom-8 sm:left-6 sm:w-20 md:w-24 lg:w-28"
	/>

	<div class="relative mx-auto flex max-w-3xl flex-col items-center gap-md text-center lg:max-w-4xl">
		<span class="ink-outline sticker-shadow-sm rounded-chip bg-cream px-md py-2 font-headline text-xs font-bold text-ink uppercase tracking-wide sm:hidden">
			1er Festival · IMJUVE Jilotepec
		</span>

		<h1
			class="font-display text-6xl leading-none font-bold tracking-[-0.02em] text-red [-webkit-text-stroke:2px_var(--color-ink)] sm:text-7xl md:text-8xl lg:text-9xl"
		>
			JUVELAND
		</h1>

		<p class="max-w-prose font-body text-lg text-ink/80 lg:text-xl">
			Música, arte, comida y Territorio Emprende — súmate también al Croquetón de Trueque con Huella. Sábado 29 de
			agosto en la Alameda de Jilotepec.
		</p>

		<a
			href="#territorio-emprende"
			class="ink-outline sticker-shadow mt-xs rounded-chip bg-red px-lg py-3 font-headline text-sm font-bold text-cream uppercase transition-transform duration-150 ease-out hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none lg:px-10 lg:py-4 lg:text-base"
		>
			Regístrate en Territorio Emprende
		</a>

		<span class="ink-outline sticker-shadow-sm rounded-chip bg-lime px-md py-2 font-headline text-xs font-bold text-ink uppercase sm:hidden">
			Sáb 29 · 2:00 PM
		</span>
	</div>

	<div class="absolute top-8 right-sm bottom-sm hidden flex-col items-end justify-between sm:flex">
		<div class="sticker-shadow rounded-full">
			<svg viewBox="0 0 120 120" class="h-24 w-24 md:h-28 md:w-28 lg:h-32 lg:w-32" role="img" aria-label="1er Festival, IMJUVE Jilotepec">
				<circle cx="60" cy="60" r="57" class="fill-cream stroke-ink" stroke-width="2" />
				<path id="hero-badge-ring" d="M60,16 A44,44 0 1,1 59.99,16" fill="none" />
				<text class="fill-ink font-headline" font-size="9" font-weight="700" letter-spacing="0.5">
					<textPath href="#hero-badge-ring">1ER FESTIVAL • IMJUVE JILOTEPEC •</textPath>
				</text>
				<path
					d="M60,38 L70,50 L82,60 L70,70 L60,82 L50,70 L38,60 L50,50 Z"
					class="fill-lime stroke-ink"
					stroke-width="2"
					stroke-linejoin="round"
				/>
			</svg>
		</div>

		<Image src={mascotaMostaza} alt="" width={200} class="pointer-events-none h-auto w-14 sm:w-16 md:w-20 lg:w-24" />

		<div class="ink-outline sticker-shadow flex flex-col items-center rounded-card bg-lime px-md py-sm lg:px-lg lg:py-md">
			<span class="font-headline text-2xl font-extrabold text-ink uppercase lg:text-3xl">Sáb 29</span>
			<span class="font-headline text-sm font-bold text-ink/80 uppercase lg:text-base">2:00 PM</span>
		</div>
	</div>
</section>
