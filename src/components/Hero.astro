---
// Hero — PLAN.md Pasada 1, paso 2 / DESIGN.md §6.
// Wordmark en HTML (contorno vía -webkit-text-stroke), insignia + stat en
// las esquinas en desktop y como chips en línea en móvil para no saturar
// una pantalla chica con overlays absolutos. El movimiento de Pasada 2
// (letras estampándose, mascotas con idle bounce, nubes con parallax) vive
// en el <script> al final del archivo — ver DESIGN.md §7.
//
// Las 3 <Image> de mascotas llevan `loading="eager"`: el Hero es la primera
// sección de la página, así que todas están arriba del pliegue desde el
// primer frame — el `loading="lazy"` por defecto de <Image> les baja
// prioridad de carga sin necesidad (el audit de Astro lo marca como
// "unoptimized loading attribute"). Mismo criterio en Loader.astro y
// Navbar.astro; el guiño de mascota del Footer, en cambio, sí se queda en
// lazy (por defecto) porque ese sí vive muy abajo del pliegue real.
import { Image } from 'astro:assets';
import Cloud from './Cloud.astro';
import mascotaVerde from '../assets/hero/mascota-verde.png';
import mascotaMostaza from '../assets/hero/mascota-mostaza.png';
---

<section id="inicio" class="relative overflow-hidden px-sm pt-lg pb-xl sm:pt-xl">
	<Cloud class="hero-cloud pointer-events-none absolute top-6 left-2 w-16 opacity-90 sm:top-8 sm:left-6 sm:w-24 md:w-28 lg:w-32" />
	<!-- Esta nube va visible en TODO ancho angosto (igual que la de la
	     izquierda, sin gating de `hidden`) y solo se oculta desde 830px, que es
	     cuando aparece el cluster de insignia/mascota/fecha de la esquina y ya
	     no hace falta — antes de eso quedaba encimada detrás del círculo de la
	     insignia. `min-[830px]:hidden` es seguro aquí (sin ninguna otra
	     variante de `display` en la misma clase compitiendo por la cascada).
	     Tamaños calcados de la nube izquierda (w-16/sm:w-24/md:w-28) para que
	     no se sienta más chica que su pareja del otro lado. -->
	<Cloud class="hero-cloud pointer-events-none absolute top-14 right-4 w-16 opacity-80 sm:w-24 md:right-12 md:w-28 min-[830px]:hidden" />

	<Image
		src={mascotaVerde}
		alt=""
		width={240}
		loading="eager"
		class="hero-mascota pointer-events-none absolute bottom-4 left-2 h-auto w-14 sm:bottom-8 sm:left-6 sm:w-20 md:w-24 lg:w-28"
	/>

	<div class="relative mx-auto flex max-w-3xl flex-col items-center gap-md text-center lg:max-w-4xl">
		<span class="ink-outline sticker-shadow-sm rounded-chip bg-cream px-md py-2 font-headline text-xs font-bold text-ink uppercase tracking-wide min-[830px]:hidden">
			1er Festival · IMJUVE Jilotepec
		</span>

		<h1
			class="hero-title font-display text-6xl leading-none font-bold tracking-[-0.02em] text-red [-webkit-text-stroke:2px_var(--color-ink)] sm:text-7xl md:text-8xl lg:text-9xl"
		>
			JUVELAND
		</h1>

		<p class="max-w-prose font-body text-lg text-ink/80 lg:text-xl">
			Música, arte, comida y Territorio Emprende — súmate también al Croquetón de Trueque con Huella. Sábado 29 de
			agosto en la Alameda de Jilotepec.
		</p>

		<a
			href="#territorio-emprende"
			class="ink-outline sticker-shadow mt-xs rounded-chip bg-red px-lg py-3 font-headline text-sm font-bold text-cream uppercase transition-transform duration-150 ease-out hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none lg:px-10 lg:py-4 lg:text-base"
		>
			Regístrate en Territorio Emprende
		</a>

		<span class="ink-outline sticker-shadow-sm rounded-chip bg-lime px-md py-2 font-headline text-xs font-bold text-ink uppercase min-[830px]:hidden">
			Sáb 29 · 2:00 PM
		</span>
	</div>

	<!-- Mascota mostaza espejo de la verde (abajo-izquierda) pero abajo-derecha
	     — visible en TODO ancho angosto igual que la verde (sin gating de
	     `hidden`, mismo criterio que la nube de arriba) y se oculta solo desde
	     830px, que es cuando el cluster de la esquina toma el relevo. Anclada
	     abajo del todo, en la misma franja de padding que la verde, para no
	     chocar con el bloque de texto centrado (que no llega hasta el borde
	     inferior). Tamaños calcados de la mascota verde (w-14/sm:w-20/md:w-24)
	     para que coincidan en todo momento con su pareja del otro lado. -->
	<Image
		src={mascotaMostaza}
		alt=""
		width={200}
		loading="eager"
		class="hero-mascota pointer-events-none absolute right-2 bottom-4 w-14 opacity-90 sm:right-6 sm:bottom-8 sm:w-20 md:w-24 min-[830px]:hidden"
	/>

	<!-- Insignia + mascota + tarjeta de fecha en la esquina — antes aparecía
	     desde sm: (640px), pero entre 640-830px la mascota mostaza se encimaba
	     con las letras de JUVELAND (poco espacio horizontal para el texto
	     centrado + el cluster absoluto a la derecha). 830px es el punto donde
	     ya no chocan; por debajo, se queda el layout tipo chip (insignia arriba
	     del título, tarjeta de fecha debajo del CTA) igual que en móvil. -->
	<div class="absolute top-8 right-sm bottom-sm hidden flex-col items-end justify-between min-[830px]:flex">
		<div class="sticker-shadow rounded-full">
			<svg viewBox="0 0 120 120" class="h-24 w-24 md:h-28 md:w-28 lg:h-32 lg:w-32" role="img" aria-label="1er Festival, IMJUVE Jilotepec">
				<circle cx="60" cy="60" r="57" class="fill-cream stroke-ink" stroke-width="2" />
				<!-- Antes el texto envolvía el círculo completo (path cerrado de
				     360°), así que la mitad de las letras — las de los costados y
				     abajo — quedaban de lado o boca abajo. Este path solo cubre un
				     arco de ~160° arriba (de las 10 a las 2, aprox.), así el texto
				     entero se lee de izquierda a derecha, casi horizontal en todo
				     momento. -->
				<path id="hero-badge-ring" d="M17,52 A44,44 0 0,1 103,52" fill="none" />
				<text class="fill-ink font-headline" font-size="8" font-weight="700" letter-spacing="0.3" text-anchor="middle">
					<textPath href="#hero-badge-ring" startOffset="51%">• 1ER FESTIVAL • JUVELAND •</textPath>
				</text>
				<path
					d="M60,38 L70,50 L82,60 L70,70 L60,82 L50,70 L38,60 L50,50 Z"
					class="fill-lime stroke-ink"
					stroke-width="2"
					stroke-linejoin="round"
				/>
			</svg>
		</div>

		<Image
			src={mascotaMostaza}
			alt=""
			width={200}
			loading="eager"
			class="hero-mascota pointer-events-none h-auto w-14 sm:w-16 md:w-20 lg:w-24"
		/>

		<div class="ink-outline sticker-shadow flex flex-col items-center rounded-card bg-lime px-md py-sm lg:px-lg lg:py-md">
			<span class="font-headline text-2xl font-extrabold text-ink uppercase lg:text-3xl">Sáb 29</span>
			<span class="font-headline text-sm font-bold text-ink/80 uppercase lg:text-base">2:00 PM</span>
		</div>
	</div>
</section>

<script>
	// Pasada 2 (PLAN.md) — Hero: "mascotas con loop de flotación/rebote, nubes
	// con parallax suave, letras JUVELAND con SplitText (pop + rotación
	// overshoot + ease elástico, ~0.05-0.08s entre letra)" — DESIGN.md §7.
	// Aislado en su propio <script> (Astro island): solo el chunk del Hero
	// carga GSAP + ScrollTrigger + SplitText, no un bundle global.
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	const section = document.querySelector<HTMLElement>('#inicio');
	const title = section?.querySelector<HTMLElement>('.hero-title');
	const mascotas = section ? Array.from(section.querySelectorAll<HTMLElement>('.hero-mascota')) : [];
	const clouds = section ? Array.from(section.querySelectorAll<HTMLElement>('.hero-cloud')) : [];

	// Dos condiciones mutuamente excluyentes que cubren el 100% de los casos
	// (mismo patrón que Navbar.astro): con una sola condición nombrada,
	// matchMedia solo invoca el callback cuando ESA media query da true, así
	// que sin la pareja `motionOk` el caso normal (sin reduced-motion) nunca
	// llegaría a crear ninguna animación.
	gsap.matchMedia().add(
		{
			reduceMotion: '(prefers-reduced-motion: reduce)',
			motionOk: '(prefers-reduced-motion: no-preference)',
		},
		(context) => {
			const { reduceMotion } = context.conditions as { reduceMotion: boolean };

			// --- JUVELAND: cada letra entra por separado, "estampándose" -------
			// Dos condiciones antes de dividir y animar:
			//  1. Fuentes cargadas: si se separa en letras con la fuente de
			//     reemplazo todavía puesta, el ancho de cada letra cambia al
			//     llegar Fredoka y el spacing/kerning queda mal.
			//  2. Loader ya retirado: su overlay vive en z-[100] tapando el Hero
			//     ~1.3s. Si el estampado corre antes, pasa entero detrás de ese
			//     overlay cream y nadie lo ve (el bug de "ya no animan" — no
			//     nace de este archivo sino del timing del Loader). `loaderGone`
			//     resuelve de inmediato si no hay loader o si ya se ocultó; si
			//     está, el Loader emite `juveland:loader-hidden` al empezar a
			//     desvanecerse.
			if (title) {
				const loaderEl = document.getElementById('loader');
				const loaderGone =
					!loaderEl || loaderEl.dataset.hidden === 'true'
						? Promise.resolve()
						: new Promise<void>((resolve) => {
								window.addEventListener('juveland:loader-hidden', () => resolve(), { once: true });
								// Salvavidas: si el script del Loader falla antes de
								// emitir el evento, no dejar "JUVELAND" invisible.
								window.setTimeout(resolve, 4500);
							});

				Promise.all([document.fonts.ready, loaderGone]).then(() => {
					const split = SplitText.create(title, { type: 'chars' });

					if (reduceMotion) {
						// DESIGN.md §7: con reduced-motion cae a un fade simple, sin
						// pop/rotación/elastic de por medio.
						gsap.from(split.chars, { opacity: 0, duration: 0.3, stagger: 0.03 });
					} else {
						gsap.from(split.chars, {
							opacity: 0,
							scale: 0.4,
							y: 20,
							rotation: () => gsap.utils.random(-18, 18),
							duration: 0.6,
							ease: 'elastic.out(1, 0.5)',
							stagger: 0.07,
						});
					}
				});
			}

			// --- Mascotas: hop/rebote en loop, con squash-stretch --------------
			// Primer intento fue un float sutil (±8px, sine) y quedó demasiado
			// discreto para el tono del festival — esta versión es un salto real
			// (anticipación aplastada → sube estirándose y se ladea → aterriza)
			// con más amplitud, que es lo que "rebote" pedía en DESIGN.md §7 y lo
			// que el usuario pidió más vistoso. Movimiento ambiental (no
			// informativo), así que con reduced-motion simplemente no se crea —
			// a diferencia del título o el Navbar, aquí no hay estado/información
			// que preservar sin el loop.
			if (!reduceMotion) {
				mascotas.forEach((mascota, i) => {
					gsap.set(mascota, { transformOrigin: '50% 100%' });

					gsap
						.timeline({ repeat: -1, delay: i * 0.25 })
						.to(mascota, { scaleX: 1.08, scaleY: 0.9, duration: 0.15, ease: 'sine.in' })
						.to(mascota, {
							y: -20,
							scaleX: 0.94,
							scaleY: 1.1,
							rotation: i % 2 === 0 ? 8 : -8,
							duration: 0.45,
							ease: 'power2.out',
						})
						.to(mascota, { y: 0, scaleX: 1, scaleY: 1, rotation: 0, duration: 0.4, ease: 'power2.in' })
						.to(mascota, {}, `+=${1.3 + i * 0.3}`);
				});
			}

			// --- Nubes: parallax al hacer scroll el Hero -------------------------
			// Primer intento (±40-60px sobre toda la altura del Hero) resultó
			// imperceptible: sobre un rango de scroll de varios cientos de px, ese
			// desplazamiento es una fracción mínima. Se sube el rango y se suma un
			// leve corrimiento horizontal en direcciones opuestas por nube (se
			// "separan" un poco al hacer scroll) para que el efecto se note sin
			// dejar de sentirse suave — `scrub: 0.6` le da un pequeño rezago en
			// vez de seguir el dedo 1:1, que es lo que más se lee como parallax.
			if (!reduceMotion && section) {
				clouds.forEach((cloud, i) => {
					gsap.to(cloud, {
						y: i === 0 ? 140 : 100,
						x: i === 0 ? 24 : -24,
						ease: 'none',
						scrollTrigger: {
							trigger: section,
							start: 'top top',
							end: 'bottom top',
							scrub: 0.6,
						},
					});
				});
			}
		},
	);
</script>
