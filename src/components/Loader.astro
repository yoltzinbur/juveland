---
// Crossfade entre los logos de IMJUVE y Pueblo Mágico, hecho solo con CSS: es
// lo primero que se pinta y no vale la pena cargar GSAP para eso.
//
// Al empezar a desvanecerse emite `juveland:loader-hidden` (ver
// `whenLoaderGone`), para que las animaciones de la página no corran mientras
// el overlay las tapa.
import { Image } from 'astro:assets';
import logoImjuve from '../assets/hero/simbolo-imjuve.png';
import logoPuebloMagico from '../assets/hero/simbolo-pueblo-magico.png';
---

<div id="loader" class="fixed inset-0 z-[100] flex flex-col items-center justify-center gap-md bg-cream px-sm">
	<div class="grid h-16 w-16 place-items-center sm:h-24 sm:w-24 lg:h-28 lg:w-28">
		<Image
			src={logoImjuve}
			alt="Logo de IMJUVE Jilotepec"
			width={140}
			loading="eager"
			class="loader-logo loader-logo-imjuve col-start-1 row-start-1 h-auto w-16 sm:w-24 lg:w-28"
		/>
		<Image
			src={logoPuebloMagico}
			alt="Logo de Jilotepec, Pueblo Mágico"
			width={140}
			loading="eager"
			class="loader-logo loader-logo-pueblo col-start-1 row-start-1 h-auto w-16 opacity-0 sm:w-24 lg:w-28"
		/>
	</div>
	<p class="font-headline text-xs font-bold tracking-wide text-ink/65 uppercase">Cargando…</p>
</div>

<style>
	#loader {
		transition: opacity 0.4s ease;
	}

	/* Con reduced-motion queda fijo el logo de IMJUVE; el de Pueblo Mágico ya
	 * trae `opacity-0` como clase estática. */
	@media (prefers-reduced-motion: no-preference) {
		.loader-logo {
			animation: loader-cross 4.4s ease-in-out infinite;
		}
		.loader-logo-pueblo {
			/* Desfase de medio ciclo; el delay negativo evita un flash inicial. */
			animation-delay: -2.2s;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#loader {
			transition-duration: 0.15s;
		}
	}

	@keyframes loader-cross {
		0%,
		100% {
			opacity: 1;
			transform: scale(1);
		}
		45%,
		55% {
			opacity: 0;
			transform: scale(0.92);
		}
	}
</style>

<script>
	const STORAGE_KEY = 'juveland:loader-seen';

	const readSeen = () => {
		try {
			return localStorage.getItem(STORAGE_KEY) === '1';
		} catch {
			return false;
		}
	};
	const markSeen = () => {
		try {
			localStorage.setItem(STORAGE_KEY, '1');
		} catch {
			// Storage bloqueado: siempre se usa la duración de primera visita.
		}
	};

	// Mínimo para que el loader alcance a verse; en visitas repetidas es más corto.
	const MIN_VISIBLE_MS = readSeen() ? 900 : 1300;
	const MAX_WAIT_MS = 4000;

	const loader = document.getElementById('loader');

	if (loader) {
		const shownAt = Date.now();
		let hidden = false;

		const hide = () => {
			if (hidden) return;
			hidden = true;
			const wait = Math.max(MIN_VISIBLE_MS - (Date.now() - shownAt), 0);

			window.setTimeout(() => {
				// El flag en dataset cubre a los listeners que llegan tarde.
				loader.dataset.hidden = 'true';
				window.dispatchEvent(new CustomEvent('juveland:loader-hidden'));
				markSeen();

				loader.style.opacity = '0';
				const done = () => {
					loader.style.display = 'none';
				};
				loader.addEventListener('transitionend', done, { once: true });
				// Por si `transitionend` nunca dispara.
				window.setTimeout(done, 600);
			}, wait);
		};

		const pageLoaded =
			document.readyState === 'complete'
				? Promise.resolve()
				: new Promise<void>((resolve) => window.addEventListener('load', () => resolve()));

		Promise.all([pageLoaded, document.fonts.ready]).then(hide);
		// En conexiones lentas, nunca más de 4 s.
		window.setTimeout(hide, MAX_WAIT_MS);
	}
</script>
