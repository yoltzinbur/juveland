---
// Chips de intro — PLAN.md Pasada 1, paso 4 / DESIGN.md §6.
// 5 círculos (Arte, Música, Emprendimiento, Expresión, Convivencia), cada uno
// con tinta de acento distinta y contorno ink, ícono + label debajo (patrón
// Alldae/Qwero confirmado en DESIGN.md).
//
// `flex-wrap` en vez del scroll-snap horizontal que tenía antes (PLAN.md
// sugería scroll-snap en móvil, pero no gustó el resultado): las tarjetas que
// no caben en la fila bajan a una segunda fila, centradas, sin scroll ni
// necesidad de puntos de corte a medida — se acomoda solo según el ancho
// real disponible en cualquier tamaño de pantalla.
//
// bg/stroke se listan como literales completos a propósito (mismo criterio
// que style-guide.astro): el escáner estático de Tailwind solo detecta clases
// que aparecen como texto completo en el archivo, no las armadas por
// interpolación de una variable arbitraria.
// El fade+rise al entrar en viewport (stagger ~0.06s, DESIGN.md §7) es
// Pasada 2 — vive en el <script> al final del archivo, aislado como isla de
// Astro propia de esta sección.
import ChipIcon from './ChipIcon.astro';

const chips = [
	{ name: 'arte' as const, label: 'Arte', bg: 'bg-purple', stroke: 'stroke-cream' },
	{ name: 'musica' as const, label: 'Música', bg: 'bg-red', stroke: 'stroke-cream' },
	{ name: 'emprendimiento' as const, label: 'Emprendimiento', bg: 'bg-green', stroke: 'stroke-ink' },
	{ name: 'expresion' as const, label: 'Expresión', bg: 'bg-orange', stroke: 'stroke-ink' },
	{ name: 'convivencia' as const, label: 'Convivencia', bg: 'bg-lime', stroke: 'stroke-ink' },
];
---

<section id="chips" class="px-sm py-xl">
	<div class="chips-heading mx-auto flex max-w-2xl flex-col items-center gap-2 text-center lg:max-w-3xl">
		<h2 class="font-headline text-2xl font-bold text-ink uppercase sm:text-3xl lg:text-4xl">¿Qué te espera en JUVELAND?</h2>
		<p class="font-body text-ink/70 lg:text-lg">Un solo día, un mismo lugar, de todo un poco.</p>
	</div>

	<div class="mx-auto mt-lg flex max-w-4xl flex-wrap justify-center gap-md lg:max-w-5xl">
		{
			chips.map((chip) => (
				<div class="chip-card flex w-24 flex-col items-center gap-sm sm:w-28 lg:w-32">
					<div
						class={`ink-outline sticker-shadow flex h-20 w-20 shrink-0 items-center justify-center rounded-full sm:h-24 sm:w-24 lg:h-28 lg:w-28 ${chip.bg}`}
					>
						<ChipIcon name={chip.name} class={`h-8 w-8 sm:h-9 sm:w-9 lg:h-10 lg:w-10 ${chip.stroke}`} />
					</div>
					<span class="font-headline text-xs font-bold text-ink uppercase sm:text-sm lg:text-base">{chip.label}</span>
				</div>
			))
		}
	</div>
</section>

<script>
	// Pasada 2 (PLAN.md) — "Chips... fade+rise por sección vía
	// IntersectionObserver, stagger ~0.06s" (DESIGN.md §7 usa ScrollTrigger
	// como el equivalente GSAP de ese patrón en todo el resto del sitio).
	// El encabezado entra primero como bloque; cada círculo se "estampa" con
	// un ligero overshoot (back.out) para que se sienta como una tarjeta
	// sticker aterrizando, no solo un fade plano.
	//
	// Afinación de rendimiento: GSAP + ScrollTrigger ya NO se importan de
	// forma estática aquí. Se cargaban en el primer load junto con las otras
	// islas y sumaban main-thread / Total Blocking Time en celular mediano sin
	// que se vieran (esta sección está bajo el pliegue). Ahora GSAP entra con
	// import() dinámico recién cuando la sección se acerca al viewport
	// (IntersectionObserver, rootMargin 200px para que llegue lista antes de
	// verse). El chunk de GSAP ya lo trae Hero/Navbar de forma estática, así
	// que este import() casi siempre resuelve al instante desde caché — lo que
	// se difiere es el trabajo (registerPlugin, crear el timeline+ScrollTrigger,
	// el immediateRender de los .from()), no la descarga.
	const section = document.querySelector<HTMLElement>('#chips');

	if (section) {
		const animate = async () => {
			const [{ gsap }, { ScrollTrigger }] = await Promise.all([
				import('gsap'),
				import('gsap/ScrollTrigger'),
			]);
			gsap.registerPlugin(ScrollTrigger);

			const heading = section.querySelector<HTMLElement>('.chips-heading');
			const cards = Array.from(section.querySelectorAll<HTMLElement>('.chip-card'));

			// Dos condiciones mutuamente excluyentes que cubren el 100% de los
			// casos, porque con una sola condición nombrada matchMedia solo
			// invoca el callback cuando ESA media query da true.
			gsap.matchMedia().add(
				{
					reduceMotion: '(prefers-reduced-motion: reduce)',
					motionOk: '(prefers-reduced-motion: no-preference)',
				},
				(context) => {
					const { reduceMotion } = context.conditions as { reduceMotion: boolean };

					const tl = gsap.timeline({
						scrollTrigger: {
							trigger: section,
							start: 'top 82%',
							toggleActions: 'play none none reverse',
						},
					});

					if (heading) {
						tl.from(heading, {
							opacity: 0,
							y: reduceMotion ? 0 : 16,
							duration: reduceMotion ? 0.3 : 0.5,
							ease: 'power2.out',
						});
					}

					if (cards.length) {
						tl.from(
							cards,
							{
								opacity: 0,
								y: reduceMotion ? 0 : 24,
								scale: reduceMotion ? 1 : 0.85,
								duration: reduceMotion ? 0.3 : 0.5,
								ease: 'back.out(1.7)',
								stagger: reduceMotion ? 0 : 0.06,
							},
							reduceMotion ? undefined : '-=0.25',
						);
					}
				},
			);
		};

		// No se empieza a observar hasta que el Loader se retira. #chips suele
		// quedar ARRIBA de la línea de disparo ('top 82%') ya en el load, así
		// que el ScrollTrigger reproduciría la entrada de inmediato — entera
		// detrás del overlay del Loader (z-[100], ~1.3s), sin que nadie la vea
		// (el mismo bug que tenían las letras del Hero). `whenLoaderGone`
		// resuelve al instante si no hay Loader o si ya se ocultó; si no,
		// espera el evento `juveland:loader-hidden` (con salvavidas por si el
		// script del Loader falla).
		const whenLoaderGone = () => {
			const loader = document.getElementById('loader');
			if (!loader || loader.dataset.hidden === 'true') return Promise.resolve();
			return new Promise<void>((resolve) => {
				window.addEventListener('juveland:loader-hidden', () => resolve(), { once: true });
				window.setTimeout(resolve, 4500);
			});
		};

		whenLoaderGone().then(() => {
			if ('IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries, obs) => {
						if (!entries.some((entry) => entry.isIntersecting)) return;
						obs.disconnect();
						animate();
					},
					{ rootMargin: '200px' },
				);
				io.observe(section);
			} else {
				animate();
			}
		});
	}
</script>
