---
// Las clases bg/stroke van completas porque Tailwind solo detecta clases
// escritas literalmente, no las armadas por interpolación.
import ChipIcon from './ChipIcon.astro';

const chips = [
	{ name: 'arte' as const, label: 'Arte', bg: 'bg-purple', stroke: 'stroke-cream' },
	{ name: 'musica' as const, label: 'Música', bg: 'bg-red', stroke: 'stroke-cream' },
	{ name: 'emprendimiento' as const, label: 'Emprendimiento', bg: 'bg-green', stroke: 'stroke-ink' },
	{ name: 'expresion' as const, label: 'Expresión', bg: 'bg-orange', stroke: 'stroke-ink' },
	{ name: 'convivencia' as const, label: 'Convivencia', bg: 'bg-lime', stroke: 'stroke-ink' },
];
---

<section id="chips" class="px-sm py-xl">
	<div class="chips-heading mx-auto flex max-w-2xl flex-col items-center gap-2 text-center lg:max-w-3xl">
		<h2 class="font-headline text-2xl font-bold text-ink uppercase sm:text-3xl lg:text-4xl">¿Qué te espera en JUVELAND?</h2>
		<p class="font-body text-ink/70 lg:text-lg">Un solo día, un mismo lugar, de todo un poco.</p>
	</div>

	<div class="mx-auto mt-lg flex max-w-4xl flex-wrap justify-center gap-md lg:max-w-5xl">
		{
			chips.map((chip) => (
				<div class="chip-card flex w-24 flex-col items-center gap-sm sm:w-28 lg:w-32">
					<div
						class={`ink-outline sticker-shadow flex h-20 w-20 shrink-0 items-center justify-center rounded-full sm:h-24 sm:w-24 lg:h-28 lg:w-28 ${chip.bg}`}
					>
						<ChipIcon name={chip.name} class={`h-8 w-8 sm:h-9 sm:w-9 lg:h-10 lg:w-10 ${chip.stroke}`} />
					</div>
					<span class="font-headline text-xs font-bold text-ink uppercase sm:text-sm lg:text-base">{chip.label}</span>
				</div>
			))
		}
	</div>
</section>

<script>
	import { onSectionReveal } from '../scripts/reveal';

	onSectionReveal('#chips', ({ gsap, section, reduceMotion }) => {
		const heading = section.querySelector<HTMLElement>('.chips-heading');
		const cards = Array.from(section.querySelectorAll<HTMLElement>('.chip-card'));

		const tl = gsap.timeline({
			scrollTrigger: {
				trigger: section,
				start: 'top 82%',
				toggleActions: 'play none none reverse',
			},
		});

		if (heading) {
			tl.from(heading, {
				opacity: 0,
				y: reduceMotion ? 0 : 16,
				duration: reduceMotion ? 0.3 : 0.5,
				ease: 'power2.out',
			});
		}

		if (cards.length) {
			tl.from(
				cards,
				{
					opacity: 0,
					y: reduceMotion ? 0 : 24,
					scale: reduceMotion ? 1 : 0.85,
					duration: reduceMotion ? 0.3 : 0.5,
					ease: 'back.out(1.7)',
					stagger: reduceMotion ? 0 : 0.06,
				},
				reduceMotion ? undefined : '-=0.25',
			);
		}
	});
</script>
