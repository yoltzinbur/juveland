---
// Arco cóncavo que cierra una banda de color de ancho completo.
// El relleno y el trazo van en paths separados para que el contorno solo
// aparezca sobre la curva. `non-scaling-stroke` mantiene el grosor aunque
// `preserveAspectRatio="none"` estire el SVG.
//
// `fillClass` se pasa completo ("fill-green") porque Tailwind solo detecta
// clases escritas literalmente.
//
// Quien lo use debe agregar `-mt-0.5` (o `-mb-0.5` con `rotate-180`) del lado
// que toca la banda: sin ese traslape, el redondeo de sub-píxel deja ver una
// línea de 1px del fondo.
interface Props {
	fillClass: string;
	class?: string;
}

const { fillClass, class: className = '' } = Astro.props;
---

<svg
	viewBox="0 0 1440 100"
	preserveAspectRatio="none"
	aria-hidden="true"
	class={`block w-full ${className}`}
>
	<path d="M0,0 H1440 V100 Q720,10 0,100 Z" class={fillClass} />
	<path
		d="M0,100 Q720,10 1440,100"
		fill="none"
		stroke="var(--color-ink)"
		stroke-width="3"
		stroke-linecap="round"
		vector-effect="non-scaling-stroke"
	/>
</svg>
