---
// Divisor de sección — cierre en arco cóncavo para el borde inferior de una
// banda de color de página completa (DESIGN.md §3: "red/blue/purple/lime/
// orange/green ceden alternando con cream"). Reusable para cualquier banda
// futura, no solo Trueque con Huella.
//
// Dos capas en el mismo viewBox: un `path` relleno (el "gorro" que cierra la
// banda — su borde superior es recto e invisible porque continúa el mismo
// fill del bloque de arriba) y un `path` solo de trazo, únicamente sobre la
// curva. Así el contorno `ink` se ve como un corte dibujado a mano, no como
// un rectángulo con esquinas de tinta de más.
//
// `preserveAspectRatio="none"` estira el ancho libremente en cualquier
// viewport; el trazo usa `vector-effect="non-scaling-stroke"` para no
// engordar/adelgazar con ese estiramiento y mantenerse en el mismo grosor
// que el resto de contornos `ink` del sitio (2-3px).
//
// `fillClass` se pasa completo desde el caller (p. ej. "fill-green") por el
// mismo criterio que Chips.astro: el escáner estático de Tailwind solo
// detecta clases que aparecen como texto literal en el archivo.
interface Props {
	fillClass: string;
	class?: string;
}

const { fillClass, class: className = '' } = Astro.props;
---

<svg
	viewBox="0 0 1440 100"
	preserveAspectRatio="none"
	aria-hidden="true"
	class={`block w-full ${className}`}
>
	<path d="M0,0 H1440 V100 Q720,10 0,100 Z" class={fillClass} />
	<path
		d="M0,100 Q720,10 1440,100"
		fill="none"
		stroke="var(--color-ink)"
		stroke-width="3"
		stroke-linecap="round"
		vector-effect="non-scaling-stroke"
	/>
</svg>
