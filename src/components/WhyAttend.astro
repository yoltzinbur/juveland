---
// Por qué venir — PLAN.md Pasada 1, paso 5 / DESIGN.md §6.
// Tarjeta con razones cortas y checkmarks estilo sticker (lime/green) en vez
// del check amarillo de Alldae. Contenido ya disponible del mensaje de
// convocatoria — nada pendiente de IMJUVE aquí.
//
// Pasada 2 (DESIGN.md §7 — "revela sus puntos en cascada, como los pasos de
// Socials Analytics, cada punto entra con su check al mismo tiempo, no todos
// de golpe"): la referencia original hablaba de un numeral 01→02→03 junto a
// cada check, pero no gustó verlo — se probó y se quitó, se queda solo el
// check. La cascada (el comportamiento que sí importaba del patrón) vive en
// el <script> al final.
const reasons = [
	{ text: 'Música en vivo todo el día, con bandas y artistas locales.', check: 'bg-lime' },
	{ text: 'Territorio Emprende: muestra o vende tu proyecto frente a todo Jilotepec.', check: 'bg-green' },
	{
		text: 'Suma tu granito de arena en el Croquetón de Trueque con Huella, en beneficio del Centro de Bienestar Animal.',
		check: 'bg-lime',
	},
	{ text: 'Entrada libre — solo trae ganas de pasarla bien.', check: 'bg-green' },
	{ text: 'Sé parte de la primera edición de JUVELAND y ayuda a escribir su historia.', check: 'bg-lime' },
];
---

<section id="por-que-venir" class="px-sm py-xl">
	<div class="ink-outline sticker-shadow mx-auto flex max-w-2xl flex-col gap-md rounded-card bg-cream p-md sm:p-lg lg:max-w-3xl lg:p-xl">
		<h2 class="why-heading font-headline text-2xl font-bold text-ink uppercase sm:text-3xl lg:text-4xl">¿Por qué venir?</h2>

		<ul class="flex flex-col gap-md">
			{
				reasons.map((reason) => (
					<li class="reason-item flex items-start gap-sm">
						<span
							class={`reason-check ink-outline sticker-shadow-sm flex h-8 w-8 shrink-0 items-center justify-center rounded-full lg:h-9 lg:w-9 ${reason.check}`}
						>
							<svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true">
								<path
									d="M3 8.5 6.5 12 13 4"
									stroke="var(--color-ink)"
									stroke-width="2.2"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</span>
						<p class="pt-1 font-body text-base text-ink/85 sm:text-lg lg:text-xl">{reason.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	// Pasada 2 (PLAN.md) — "Por qué venir" en cascada numerada 01→02→03, como
	// los pasos de Socials Analytics: cada punto entra con su numeral y su
	// check al mismo tiempo (no son animaciones separadas dentro del mismo
	// punto), pero los puntos entre sí sí van uno detrás de otro, no todos de
	// golpe — de ahí el stagger más largo que en Chips.astro (ahí eran 5
	// círculos chicos entrando casi juntos; aquí son pasos que se quieren
	// leer en secuencia).
	//
	// Afinación de rendimiento (mismo criterio que Chips/Agenda/Bandas): GSAP +
	// ScrollTrigger ya NO se importan estático — esta sección está bajo el
	// pliegue, así que GSAP entra con import() dinámico recién cuando se acerca
	// al viewport (IntersectionObserver, rootMargin 200px). El chunk de GSAP ya
	// lo trae Hero/Navbar de forma estática, así que el import() resuelve desde
	// caché; lo que se difiere es el trabajo, no la descarga.
	const section = document.querySelector<HTMLElement>('#por-que-venir');

	if (section) {
		const animate = async () => {
			const [{ gsap }, { ScrollTrigger }] = await Promise.all([
				import('gsap'),
				import('gsap/ScrollTrigger'),
			]);
			gsap.registerPlugin(ScrollTrigger);

			const heading = section.querySelector<HTMLElement>('.why-heading');
			const items = Array.from(section.querySelectorAll<HTMLElement>('.reason-item'));
			const checks = Array.from(section.querySelectorAll<HTMLElement>('.reason-check'));

			// Dos condiciones mutuamente excluyentes que cubren el 100% de los casos.
			gsap.matchMedia().add(
				{
					reduceMotion: '(prefers-reduced-motion: reduce)',
					motionOk: '(prefers-reduced-motion: no-preference)',
				},
				(context) => {
					const { reduceMotion } = context.conditions as { reduceMotion: boolean };

					const tl = gsap.timeline({
						scrollTrigger: {
							trigger: section,
							start: 'top 78%',
							toggleActions: 'play none none reverse',
						},
					});

					if (heading) {
						tl.from(heading, {
							opacity: 0,
							y: reduceMotion ? 0 : 16,
							duration: reduceMotion ? 0.3 : 0.5,
							ease: 'power2.out',
						});
					}

					if (items.length) {
						// El punto completo (numeral + check + texto) entra como un solo
						// bloque fade+rise — "el numeral y el check al mismo tiempo" ya sale
						// gratis al animar el <li> entero en vez de sus partes por separado.
						tl.from(
							items,
							{
								opacity: 0,
								y: reduceMotion ? 0 : 20,
								duration: reduceMotion ? 0.3 : 0.5,
								ease: 'power2.out',
								stagger: reduceMotion ? 0 : 0.15,
							},
							reduceMotion ? undefined : '-=0.2',
						);
					}

					// El check, además, se "tica" con un pop propio superpuesto al mismo
					// instante en que aparece su punto — refuerza la sensación de "listo,
					// siguiente" en vez de un fade genérico.
					if (checks.length && !reduceMotion) {
						tl.from(
							checks,
							{
								scale: 0.4,
								duration: 0.4,
								ease: 'back.out(2)',
								stagger: 0.15,
							},
							'<',
						);
					}
				},
			);
		};

		// No se empieza a observar hasta que el Loader se retira: si la sección
		// ya está por encima de la línea de disparo del ScrollTrigger en el
		// load, la entrada se reproduciría entera detrás del overlay del Loader
		// (z-[100], ~1.3s) sin que nadie la vea. `whenLoaderGone` resuelve al
		// instante si no hay Loader o si ya se ocultó; si no, espera el evento
		// `juveland:loader-hidden` (con salvavidas por si el Loader falla).
		const whenLoaderGone = () => {
			const loader = document.getElementById('loader');
			if (!loader || loader.dataset.hidden === 'true') return Promise.resolve();
			return new Promise<void>((resolve) => {
				window.addEventListener('juveland:loader-hidden', () => resolve(), { once: true });
				window.setTimeout(resolve, 4500);
			});
		};

		whenLoaderGone().then(() => {
			if ('IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries, obs) => {
						if (!entries.some((entry) => entry.isIntersecting)) return;
						obs.disconnect();
						animate();
					},
					{ rootMargin: '200px' },
				);
				io.observe(section);
			} else {
				animate();
			}
		});
	}
</script>
