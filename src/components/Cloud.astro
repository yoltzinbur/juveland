// nunca como fondo denso"). Geometría simple (círculos superpuestos), sin
// parallax todavía (eso es Pasada 2, DESIGN.md §7).
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg viewBox="0 0 64 40" role="img" aria-hidden="true" class={className}>
