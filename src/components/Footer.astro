---
// Los logos oficiales ya traen el contorno blanco tipo sticker en el PNG, así
// que no llevan `cream-outline`. <Image> los reduce en build al tamaño real
// en pantalla.
import { Image } from 'astro:assets';
import mascotaVerde from '../assets/hero/mascota-verde.png';
import logoAyuntamiento from '../assets/logo/logo-ayuntamiento.png';
import logoImjuve from '../assets/logo/logo-imjuve.png';
import logoPuebloMagico from '../assets/logo/logo-pueblo-magico.png';
import SocialIcon from './SocialIcon.astro';
import { socialAccounts } from '../data/social';
import { navLinks as links } from '../data/nav';

const footerLogos = [
	{ src: logoImjuve, alt: 'IMJUVE Jilotepec' },
	{ src: logoAyuntamiento, alt: 'Ayuntamiento Constitucional de Jilotepec' },
	{ src: logoPuebloMagico, alt: 'Jilotepec, Pueblo Mágico' },
];
---

<footer id="contacto" class="bg-ink px-sm py-xl">
	<div class="mx-auto flex max-w-4xl flex-col gap-xl">
		<div class="grid grid-cols-1 gap-lg text-center sm:grid-cols-3 sm:text-left">
			<div class="flex flex-col items-center gap-2 sm:items-start">
				<span class="font-display text-2xl font-semibold text-cream lg:text-3xl">Juveland</span>
				<p class="font-body text-sm text-cream/70 lg:text-base">
					1er Festival de las Juventudes de Jilotepec — sábado 29 de agosto, Alameda de Jilotepec.
				</p>
			</div>

			<div class="flex flex-col items-center gap-2 sm:items-start">
				<span class="font-headline text-xs font-bold tracking-wide text-cream/70 uppercase lg:text-sm">Navegación</span>
				<ul class="flex flex-col items-center gap-1 sm:items-start">
					{
						links.map((link) => (
							<li>
								<a
									href={link.href}
									class="font-body text-sm text-cream/80 transition-colors hover:text-lime lg:text-base"
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="flex flex-col items-center gap-2 sm:items-start">
				<span class="font-headline text-xs font-bold tracking-wide text-cream/70 uppercase lg:text-sm">Contacto</span>
				<p class="font-body text-sm text-cream/80 lg:text-base">Escríbenos por redes:</p>
				<div class="flex items-center gap-2">
					{
						socialAccounts.map((account) => (
							<a
								href={account.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${account.platformLabel}: ${account.name}`}
								class={`cream-outline flex h-9 w-9 items-center justify-center rounded-full transition-transform duration-150 ease-out hover:-translate-y-0.5 lg:h-10 lg:w-10 ${account.bg}`}
							>
								<SocialIcon name={account.platform} class={`h-4 w-4 lg:h-5 lg:w-5 ${account.text}`} />
							</a>
						))
					}
				</div>
			</div>
		</div>

		<div class="flex flex-col items-center gap-md border-t border-cream/15 pt-lg">
			<div class="flex flex-wrap items-center justify-center gap-lg">
				{
					footerLogos.map((logo) => (
						<Image src={logo.src} alt={logo.alt} height={112} class="h-12 w-auto lg:h-14" />
					))
				}
			</div>

			<div class="flex flex-col items-center gap-xs text-center">
				<Image src={mascotaVerde} alt="" width={80} class="h-auto w-8 opacity-80 lg:w-10" />
				<p class="font-body text-xs text-cream/60 lg:text-sm">
					© 2026 Juveland — 1er Festival de las Juventudes de Jilotepec, IMJUVE.
				</p>
			</div>
		</div>
	</div>
</footer>
