---
// Síguenos — PLAN.md Pasada 1, paso 9 / DESIGN.md §6.
// DESIGN.md ofrecía dos caminos: tira de posts reales de Instagram (requiere
// API) o, si no da tiempo, tarjetas estáticas + botón de síguenos. Con las 4
// cuentas reales que mandó el usuario (2 IMJUVE, 2 Jilotepec/Turismo) se
// construye la segunda opción — enlaces reales y honestos, sin inventar
// capturas de posts que no tenemos ni fabricar contenido de esas cuentas.
// Datos en src/data/social.ts — compartidos con Footer.astro (paso 12).
import SocialIcon from './SocialIcon.astro';
import { socialAccounts as accounts } from '../data/social';
---

<section class="px-sm py-xl">
	<div class="mx-auto flex max-w-2xl flex-col items-center gap-md text-center lg:max-w-3xl">
		<div class="flex flex-col items-center gap-2">
			<h2 class="font-headline text-2xl font-bold text-ink uppercase sm:text-3xl lg:text-4xl">Síguenos</h2>
			<p class="font-body text-ink/70 lg:text-lg">No te pierdas nada de Juveland, IMJUVE y Jilotepec.</p>
		</div>

		<div class="grid w-full grid-cols-1 gap-sm sm:grid-cols-2">
			{
				accounts.map((account) => (
					<a
						href={account.href}
						target="_blank"
						rel="noopener noreferrer"
						class="ink-outline sticker-shadow-sm flex items-center gap-sm rounded-card bg-cream px-md py-sm transition-transform duration-150 ease-out hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none lg:px-lg lg:py-md"
					>
						<span
							class={`ink-outline flex h-12 w-12 shrink-0 items-center justify-center rounded-full lg:h-14 lg:w-14 ${account.bg}`}
						>
							<SocialIcon name={account.platform} class={`h-6 w-6 lg:h-7 lg:w-7 ${account.text}`} />
						</span>
						<span class="flex flex-col text-left">
							<span class="font-headline text-sm font-bold text-ink uppercase lg:text-base">{account.name}</span>
							<span class="font-body text-xs text-ink/60 lg:text-sm">
								{account.platformLabel} · {account.handle}
							</span>
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>
