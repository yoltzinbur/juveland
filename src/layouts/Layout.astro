---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Loader from '../components/Loader.astro';

interface Props {
	title?: string;
	description?: string;
	showLoader?: boolean;
}

const {
	title = 'Juveland — 1er Festival de las Juventudes de Jilotepec',
	description = 'Sábado 29 de agosto, Jilotepec. Música en vivo, Territorio Emprende y más — organizado por IMJUVE Jilotepec.',
	showLoader = true,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<Font cssVariable="--font-baloo-2" preload />
		<Font cssVariable="--font-nunito" preload />
		<Font cssVariable="--font-fredoka" />
	</head>
	<body>
		{showLoader && <Loader />}
		<slot />
		<Analytics />
		<SpeedInsights />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
