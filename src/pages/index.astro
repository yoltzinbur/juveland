---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Chips from '../components/Chips.astro';
import WhyAttend from '../components/WhyAttend.astro';
import Trueque from '../components/Trueque.astro';
import Agenda from '../components/Agenda.astro';
import Bandas from '../components/Bandas.astro';
import Social from '../components/Social.astro';
---

<Layout>
	<Navbar />
	<main>
		<Hero />
		<Chips />
		<WhyAttend />
		<Trueque />
		<Agenda />
		<Bandas />
		<Social />
		<!-- [pendiente PLAN.md Pasada 1] Mapa, formulario y footer van aquí en las próximas sesiones. -->
		<section class="flex min-h-[40vh] items-start justify-center px-sm pt-xl">
			<p class="max-w-prose text-center font-body text-ink/60">Próxima sección: Mapa (PLAN.md — Pasada 1, paso 10).</p>
		</section>
	</main>
</Layout>
